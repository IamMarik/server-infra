# Target: /etc/server-infra/proxy/runtime.env
# Required permissions: root:root 0600
# Changes require proxy validation and redeployment.
# Copy this example outside Git and replace every placeholder.

# Required. Sensitive: no. Caddy ACME account email.
CADDY_EMAIL=admin@example.invalid

# Required while the legacy monitoring routes remain active. Sensitive: no.
STATUS_DOMAIN=status.example.invalid
LOGS_DOMAIN=logs.example.invalid

# Required while the legacy logs route remains active. Sensitive: yes.
LOGS_AUTH_USER=<logs-user>
LOGS_AUTH_PASSWORD_HASH=<bcrypt-hash>

# Required while Porkbun DNS challenges are enabled. Sensitive: yes.
PORKBUN_API_KEY=<porkbun-api-key>
PORKBUN_API_SECRET_KEY=<porkbun-api-secret-key>
