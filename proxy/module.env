MODULE_DESCRIPTION="Public reverse proxy"
MODULE_VERSION=1
MODULE_DRIVER=compose
REQUIRED_ENV="CADDY_EMAIL STATUS_DOMAIN LOGS_DOMAIN LOGS_AUTH_USER LOGS_AUTH_PASSWORD_HASH PORKBUN_API_KEY PORKBUN_API_SECRET_KEY"
RUNTIME_ENV_MODE=0600
REQUIRED_CONFIG_DIRS="conf.d"
EXAMPLE_CONFIG_FILES="conf.d/service.caddy.example"
