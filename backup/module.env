MODULE_DESCRIPTION="Encrypted off-site host backups"
MODULE_VERSION=1
MODULE_DRIVER=host
REQUIRED_ENV="RESTIC_REPOSITORY RESTIC_PASSWORD_FILE AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_DEFAULT_REGION UPTIME_KUMA_BACKUP_PUSH_URL UPTIME_KUMA_CHECK_PUSH_URL UPTIME_KUMA_RESTORE_TEST_PUSH_URL BACKUP_KEEP_DAILY BACKUP_KEEP_WEEKLY BACKUP_KEEP_MONTHLY BACKUP_RETENTION_ENABLED BACKUP_PRUNE_ENABLED"
RUNTIME_ENV_MODE=0600
REQUIRED_CONFIG_DIRS=""
REQUIRED_CONFIG_FILES="paths excludes freshness"
EXAMPLE_CONFIG_FILES="paths.example excludes.example freshness.example"
HOST_EXECUTABLES="bin/server-infra-backup bin/server-infra-backup-project bin/server-infra-backup-setup"
HOST_PUBLIC_EXECUTABLES="bin/server-infra-backup"
HOST_REQUIRED_COMMANDS="restic curl"
HOST_PREFLIGHT_EXECUTABLE="bin/server-infra-backup"
HOST_STATE_DIRS="staging state"
HOST_CACHE_DIRS="restic restore-tests"
SYSTEMD_UNITS="systemd/server-infra-backup.service systemd/server-infra-backup.timer systemd/server-infra-backup-init.service systemd/server-infra-backup-check.service systemd/server-infra-backup-check.timer systemd/server-infra-backup-restore-test.service systemd/server-infra-backup-restore-test.timer"
SYSTEMD_ENABLE_UNITS="server-infra-backup.timer server-infra-backup-check.timer server-infra-backup-restore-test.timer"
