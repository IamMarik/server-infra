[Unit]
Description=Test Server Infra configuration restore
Documentation=https://restic.net/
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/server-infra/backup/runtime.env

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/server-infra/backup/server-infra-backup --config-root /etc/server-infra restore-test
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
TimeoutStartSec=infinity
