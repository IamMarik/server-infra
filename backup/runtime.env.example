# Target: /etc/server-infra/backup/runtime.env
# Required permissions: root:root 0600
# All values are required. This file contains secrets.

# Sensitive: no. Use an explicit path-style S3-compatible repository URL.
RESTIC_REPOSITORY=s3:https://s3.example.invalid/example-bucket

# Sensitive: no. The password file must be root:root 0600.
RESTIC_PASSWORD_FILE=/etc/server-infra/backup/restic-password

# Sensitive: yes. Use credentials restricted to this server's bucket.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Sensitive: no. Use the Backblaze region for the bucket.
AWS_DEFAULT_REGION=example-region

# Sensitive: yes. Use three distinct push monitors and store their base URLs
# without query parameters.
UPTIME_KUMA_BACKUP_PUSH_URL=https://status.example.invalid/api/push/replace-me
UPTIME_KUMA_CHECK_PUSH_URL=https://status.example.invalid/api/push/replace-me
UPTIME_KUMA_RESTORE_TEST_PUSH_URL=https://status.example.invalid/api/push/replace-me

# Sensitive: no. Positive snapshot counts.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12

# Sensitive: no. Keep false until retention behavior is validated.
BACKUP_RETENTION_ENABLED=false

# Sensitive: no. Keep false until Object Lock and prune are validated.
BACKUP_PRUNE_ENABLED=false
