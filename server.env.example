# Target: /etc/server-infra/server.env
# Required permissions: root:root 0640
# Changes require validation before the next infrastructure operation.

# Required. Configuration contract version. Sensitive: no.
SERVER_INFRA_CONFIG_VERSION=1

# Required. Stable lowercase host identity used in Compose project names.
# Sensitive: no. Changing it requires a separate named-volume migration.
SERVER_INFRA_INSTANCE=example

# Required. Human-readable deployment classification. Sensitive: no.
SERVER_INFRA_ENVIRONMENT=example

# Required. IANA timezone name. Sensitive: no.
SERVER_INFRA_TIMEZONE=Etc/UTC
