#!/usr/bin/env bash

set -Eeuo pipefail

RECOVERY_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RECOVERY_ROOT="$(cd "$RECOVERY_BIN_DIR/.." && pwd)"
REPOSITORY_ROOT="$(cd "$RECOVERY_ROOT/.." && pwd)"
# shellcheck source=../../scripts/common.sh
source "$REPOSITORY_ROOT/scripts/common.sh"

STATE_VERSION=1
STATE_ROOT="/var/lib/server-infra/recovery"
STATE_FILE=""
CONFIG_ROOT="/etc/server-infra"
WORK_ROOT="/var/cache/server-infra/recovery"
OPERATION=""
BREAK_GLASS_FILE=""
SNAPSHOT_ID=""
PROJECT_NAME=""
GIT_USER=""
TEMP_FILE=""
LOCK_DIR=""
RESTORE_TARGET=""
INSTALL_TEMP=""
PROJECT_CLONE_TEMP=""
PROJECT_RESTORE_TARGET=""
PROJECT_INSTALL_TEMP=""
CONFIG_INSTALLED_BY_RUN=0
PROJECT_FILE_PATHS=()

recovery_log() {
  printf '[server-infra][recovery] %s\n' "$*"
}

recovery_ok() {
  printf '[server-infra][recovery][ok] %s\n' "$*"
}

recovery_warn() {
  printf '[server-infra][recovery][warn] %s\n' "$*" >&2
}

usage() {
  cat <<'USAGE'
Usage:
  server-infra-recovery [--state-root <absolute-path>] \
    init --break-glass <absolute-path>
  server-infra-recovery [--state-root <absolute-path>] plan
  server-infra-recovery [--state-root <absolute-path>] status
  server-infra-recovery [--state-root <absolute-path>] \
    config-snapshots --break-glass <absolute-path>
  server-infra-recovery [--state-root <absolute-path>] \
    [--config-root <absolute-path>] [--work-root <absolute-path>] \
    restore-config --break-glass <absolute-path> --snapshot <exact-id>
  server-infra-recovery [--state-root <absolute-path>] \
    [--config-root <absolute-path>] \
    data-snapshots --break-glass <absolute-path>
  server-infra-recovery [--state-root <absolute-path>] \
    [--config-root <absolute-path>] \
    select-data --break-glass <absolute-path> --snapshot <exact-id>
  server-infra-recovery [--state-root <absolute-path>] \
    [--config-root <absolute-path>] \
    projects-plan --break-glass <absolute-path>
  server-infra-recovery [--state-root <absolute-path>] \
    [--config-root <absolute-path>] \
    clone-project --break-glass <absolute-path> \
    --name <source-name> --git-user <ordinary-user>
  server-infra-recovery [--state-root <absolute-path>] \
    [--config-root <absolute-path>] [--work-root <absolute-path>] \
    restore-project-files --break-glass <absolute-path> \
    --name <source-name> --git-user <ordinary-user>

Operations:
  init
    Validate a break-glass record against the current Git checkout and create
    a resumable, non-secret recovery session.
  plan
    Show the ordered recovery phases and the next incomplete phase.
  status
    Show recovery session metadata and phase state.
  config-snapshots
    List configuration snapshots for the recorded server without changing
    recovery state.
  restore-config
    Restore one exact configuration snapshot, validate it, and install it only
    when the active configuration root is absent.
  data-snapshots
    List data snapshots after configuration recovery is complete.
  select-data
    Verify and pin one data snapshot for every project in this recovery.
  projects-plan
    Validate and print the recovered project Git inventory.
  clone-project
    Clone one project as an ordinary user and detach it at the recorded commit.
  restore-project-files
    Restore declared application files from the pinned data snapshot without
    restoring the PostgreSQL staging directory or overwriting existing paths.

The implementation does not yet restore databases, install project backup
sources, deploy infrastructure, or start traffic. Follow backup/RECOVERY.md
for those phases.

Defaults to:
  --state-root /var/lib/server-infra/recovery
  --config-root /etc/server-infra
  --work-root /var/cache/server-infra/recovery
USAGE
}

validate_absolute_path() {
  local path_value="$1"
  local path_label="$2"

  [[ "$path_value" == /* ]] || fail "$path_label must be an absolute path"
  [[ "$path_value" != *".."* ]] || fail "$path_label must not contain .."
  [[ "$path_value" != *"//"* ]] || fail "$path_label must not contain //"
  [[ "$path_value" != *$'\n'* && "$path_value" != *$'\r'* ]] || \
    fail "$path_label contains an invalid line break"
}

validate_no_symlink_components() {
  local path_value="$1"
  local path_label="$2"
  local current_path=""
  local component
  local components=()

  IFS='/' read -r -a components <<< "${path_value#/}"
  for component in "${components[@]}"; do
    [[ -n "$component" ]] || continue
    current_path="$current_path/$component"
    [[ ! -L "$current_path" ]] || \
      fail "$path_label contains a symlinked path component: $current_path"
  done
}

file_mode() {
  local file_path="$1"

  case "$(uname -s)" in
    Linux)
      stat -c '%a' "$file_path"
      ;;
    Darwin)
      stat -f '%Lp' "$file_path"
      ;;
    *)
      fail "Unsupported platform for permission validation"
      ;;
  esac
}

file_owner_id() {
  local file_path="$1"

  case "$(uname -s)" in
    Linux)
      stat -c '%u' "$file_path"
      ;;
    Darwin)
      stat -f '%u' "$file_path"
      ;;
    *)
      fail "Unsupported platform for ownership validation"
      ;;
  esac
}

file_group_id() {
  local file_path="$1"

  case "$(uname -s)" in
    Linux)
      stat -c '%g' "$file_path"
      ;;
    Darwin)
      stat -f '%g' "$file_path"
      ;;
    *)
      fail "Unsupported platform for ownership validation"
      ;;
  esac
}

is_placeholder_value() {
  local value="$1"

  case "$value" in
    "" | example | replace-me | changeme | not-recorded | *.invalid)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

validate_repository_url() {
  local repository_url="$1"
  local authority
  local user_info

  [[ -n "$repository_url" ]] || fail "Git repository URL must not be empty"
  [[ "$repository_url" != *[[:space:]]* ]] || \
    fail "Git repository URL must not contain whitespace"
  [[ "$repository_url" != *"?"* && "$repository_url" != *"#"* ]] || \
    fail "Git repository URL must not contain query parameters or fragments"

  case "$repository_url" in
    https://* | ssh://* | git@*:*)
      ;;
    *)
      fail "Unsupported Git repository URL: use HTTPS or SSH"
      ;;
  esac

  if [[ "$repository_url" == https://* ]]; then
    authority="${repository_url#https://}"
    authority="${authority%%/*}"
    [[ "$authority" != *"@"* ]] || \
      fail "Git repository URL must not contain embedded credentials"
  elif [[ "$repository_url" == ssh://* ]]; then
    authority="${repository_url#ssh://}"
    authority="${authority%%/*}"
    if [[ "$authority" == *"@"* ]]; then
      user_info="${authority%@*}"
      [[ "$user_info" != *":"* ]] || \
        fail "Git repository URL must not contain embedded credentials"
    fi
  fi
}

validate_source_name() {
  local source_name="$1"

  [[ "$source_name" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || \
    fail "Project source name must use lowercase kebab-case"
}

validate_deploy_commit() {
  local deploy_commit="$1"

  [[ "$deploy_commit" =~ ^[0-9a-f]{40}$ || \
    "$deploy_commit" =~ ^[0-9a-f]{64}$ ]] || \
    fail "Project deploy commit must be a full lowercase object ID"
}

validate_git_user() {
  local git_user="$1"
  local git_uid

  [[ "$git_user" =~ ^[a-z_][a-z0-9_-]*\$?$ ]] || \
    fail "Git user has an invalid account name"
  git_uid="$(id -u "$git_user" 2>/dev/null)" || \
    fail "Git user does not exist: $git_user"
  [[ "$git_uid" != "0" ]] || \
    fail "Project Git operations must not run as root"
}

validate_state_root() {
  local normalized_root="${STATE_ROOT%/}"
  local physical_repository_root

  validate_absolute_path "$STATE_ROOT" "Recovery state root"
  case "$normalized_root" in
    "" | / | /var | /var/lib | /etc | /run | /tmp | /home | /root | /usr | /opt)
      fail "Refusing unsafe recovery state root: $STATE_ROOT"
      ;;
  esac
  validate_no_symlink_components "$STATE_ROOT" "Recovery state root"
  physical_repository_root="$(cd "$REPOSITORY_ROOT" && pwd -P)"
  case "$normalized_root/" in
    "$physical_repository_root/"*)
      fail "Recovery state must be outside the server-infra repository"
      ;;
  esac

  if [[ "$(uname -s)" == "Linux" && \
    "$normalized_root" == "/var/lib/server-infra/recovery" && \
    "$(id -u)" != "0" ]]; then
    fail "Default recovery state must be managed as root"
  fi
}

validate_secret_record_file() {
  local record_file="$1"
  local mode
  local owner_id
  local current_id

  validate_absolute_path "$record_file" "Break-glass path"
  validate_no_symlink_components "$record_file" "Break-glass path"
  [[ -f "$record_file" ]] || fail "Break-glass record not found: $record_file"
  [[ -r "$record_file" ]] || \
    fail "Break-glass record is not readable: $record_file"
  [[ ! -L "$record_file" ]] || \
    fail "Break-glass record must not be a symlink"

  mode="$(file_mode "$record_file")"
  [[ "$mode" == "600" ]] || \
    fail "Break-glass record must have mode 0600; found 0$mode"

  owner_id="$(file_owner_id "$record_file")"
  current_id="$(id -u)"
  if [[ "$current_id" == "0" && -n "${SUDO_UID:-}" ]]; then
    [[ "$SUDO_UID" =~ ^[0-9]+$ ]] || fail "Invalid sudo user metadata"
    [[ "$owner_id" == "0" || "$owner_id" == "$SUDO_UID" ]] || \
      fail "Break-glass record must belong to root or the invoking sudo user"
  else
    [[ "$owner_id" == "$current_id" ]] || \
      fail "Break-glass record must belong to the invoking user"
  fi
}

read_break_glass() {
  local record_file="$1"
  local allowed_keys=$'\nBREAK_GLASS_VERSION\nGENERATED_AT\nSERVER_INFRA_INSTANCE\nSERVER_INFRA_REPOSITORY_URL\nSERVER_INFRA_REPOSITORY_REF\nRESTIC_REPOSITORY\nRESTIC_PASSWORD\nAWS_ACCESS_KEY_ID\nAWS_SECRET_ACCESS_KEY\nAWS_DEFAULT_REGION\n'
  local seen_keys=$'\n'
  local line=""
  local key
  local value

  BREAK_GLASS_VERSION=""
  BREAK_GLASS_GENERATED_AT=""
  BREAK_GLASS_INSTANCE=""
  BREAK_GLASS_REPOSITORY_URL=""
  BREAK_GLASS_REPOSITORY_REF=""
  BREAK_GLASS_RESTIC_REPOSITORY=""
  BREAK_GLASS_RESTIC_PASSWORD=""
  BREAK_GLASS_AWS_ACCESS_KEY_ID=""
  BREAK_GLASS_AWS_SECRET_ACCESS_KEY=""
  BREAK_GLASS_AWS_DEFAULT_REGION=""

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ "$line" =~ ^([A-Z][A-Z0-9_]*):[[:space:]](.*)$ ]] || continue
    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"
    [[ "$allowed_keys" == *$'\n'"$key"$'\n'* ]] || continue
    [[ "$seen_keys" != *$'\n'"$key"$'\n'* ]] || \
      fail "Duplicate field $key in break-glass record"
    seen_keys+="$key"$'\n'

    case "$key" in
      BREAK_GLASS_VERSION)
        BREAK_GLASS_VERSION="$value"
        ;;
      GENERATED_AT)
        BREAK_GLASS_GENERATED_AT="$value"
        ;;
      SERVER_INFRA_INSTANCE)
        BREAK_GLASS_INSTANCE="$value"
        ;;
      SERVER_INFRA_REPOSITORY_URL)
        BREAK_GLASS_REPOSITORY_URL="$value"
        ;;
      SERVER_INFRA_REPOSITORY_REF)
        BREAK_GLASS_REPOSITORY_REF="$value"
        ;;
      RESTIC_REPOSITORY)
        BREAK_GLASS_RESTIC_REPOSITORY="$value"
        ;;
      RESTIC_PASSWORD)
        BREAK_GLASS_RESTIC_PASSWORD="$value"
        ;;
      AWS_ACCESS_KEY_ID)
        BREAK_GLASS_AWS_ACCESS_KEY_ID="$value"
        ;;
      AWS_SECRET_ACCESS_KEY)
        BREAK_GLASS_AWS_SECRET_ACCESS_KEY="$value"
        ;;
      AWS_DEFAULT_REGION)
        BREAK_GLASS_AWS_DEFAULT_REGION="$value"
        ;;
    esac
  done < "$record_file"

  [[ "$BREAK_GLASS_VERSION" == "1" ]] || \
    fail "Unsupported or missing BREAK_GLASS_VERSION"
  [[ "$BREAK_GLASS_GENERATED_AT" =~ \
    ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || \
    fail "GENERATED_AT has an invalid format"
  [[ "$BREAK_GLASS_INSTANCE" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || \
    fail "SERVER_INFRA_INSTANCE must use lowercase kebab-case"
  validate_repository_url "$BREAK_GLASS_REPOSITORY_URL"
  [[ "$BREAK_GLASS_REPOSITORY_REF" =~ ^[0-9a-f]{40}$ || \
    "$BREAK_GLASS_REPOSITORY_REF" =~ ^[0-9a-f]{64}$ ]] || \
    fail "SERVER_INFRA_REPOSITORY_REF must be an exact Git commit"
  [[ "$BREAK_GLASS_RESTIC_REPOSITORY" == s3:https://* ]] || \
    fail "RESTIC_REPOSITORY must use an S3-compatible HTTPS URL"
  [[ "$BREAK_GLASS_AWS_DEFAULT_REGION" =~ ^[a-z0-9][a-z0-9-]*$ ]] || \
    fail "AWS_DEFAULT_REGION has an invalid format"

  for value in \
    "$BREAK_GLASS_RESTIC_REPOSITORY" \
    "$BREAK_GLASS_RESTIC_PASSWORD" \
    "$BREAK_GLASS_AWS_ACCESS_KEY_ID" \
    "$BREAK_GLASS_AWS_SECRET_ACCESS_KEY" \
    "$BREAK_GLASS_AWS_DEFAULT_REGION"; do
    ! is_placeholder_value "$value" || \
      fail "Break-glass record contains an empty or placeholder recovery value"
  done
}

validate_current_repository() {
  local current_url
  local current_ref

  require_command git
  git -C "$REPOSITORY_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 || \
    fail "Recovery CLI must run from a Git checkout"

  current_url="$(git -C "$REPOSITORY_ROOT" remote get-url origin)" || \
    fail "Unable to read the server-infra origin URL"
  current_ref="$(git -C "$REPOSITORY_ROOT" rev-parse HEAD)" || \
    fail "Unable to read the server-infra Git commit"
  [[ -z "$(git -C "$REPOSITORY_ROOT" status --porcelain --untracked-files=no)" ]] || \
    fail "Tracked server-infra files are modified"

  [[ "$current_url" == "$BREAK_GLASS_REPOSITORY_URL" ]] || \
    fail "Current server-infra origin does not match the break-glass record"
  [[ "$current_ref" == "$BREAK_GLASS_REPOSITORY_REF" ]] || \
    fail "Current server-infra commit does not match the break-glass record"
}

validate_state_file() {
  local allowed_keys=$'\nRECOVERY_STATE_VERSION\nRECOVERY_SESSION_ID\nRECOVERY_INSTANCE\nRECOVERY_STARTED_AT\nRECOVERY_BREAK_GLASS_GENERATED_AT\nRECOVERY_INFRA_REPOSITORY_URL\nRECOVERY_INFRA_REPOSITORY_REF\nRECOVERY_STATUS\nRECOVERY_PHASE_REPOSITORY\nRECOVERY_PHASE_CONFIG\nRECOVERY_CONFIG_SNAPSHOT\nRECOVERY_PHASE_DATA\nRECOVERY_DATA_SNAPSHOT\nRECOVERY_PHASE_PROJECTS\nRECOVERY_PHASE_FINALIZE\n'
  local line=""
  local line_number=0
  local seen_keys=$'\n'
  local phase

  [[ -f "$STATE_FILE" ]] || fail "Recovery session is not initialized"
  [[ ! -L "$STATE_FILE" ]] || fail "Recovery state file must not be a symlink"
  [[ -r "$STATE_FILE" ]] || fail "Recovery state file is not readable"
  [[ "$(file_mode "$STATE_FILE")" == "600" ]] || \
    fail "Recovery state file must have mode 0600"
  [[ "$(file_owner_id "$STATE_FILE")" == "$(id -u)" ]] || \
    fail "Recovery state file must belong to the invoking user"
  validate_env_file "$STATE_FILE"

  while IFS= read -r line || [[ -n "$line" ]]; do
    line_number=$((line_number + 1))
    parse_env_line "$line" "$STATE_FILE" "$line_number"
    [[ "$PARSED_ENV_KIND" == "assignment" ]] || continue
    [[ "$allowed_keys" == *$'\n'"$PARSED_ENV_KEY"$'\n'* ]] || \
      fail "Unknown key $PARSED_ENV_KEY in recovery state"
    [[ "$seen_keys" != *$'\n'"$PARSED_ENV_KEY"$'\n'* ]] || \
      fail "Duplicate key $PARSED_ENV_KEY in recovery state"
    seen_keys+="$PARSED_ENV_KEY"$'\n'
  done < "$STATE_FILE"

  RECOVERY_STATE_VERSION="$(
    read_required_env_value "$STATE_FILE" "RECOVERY_STATE_VERSION"
  )"
  RECOVERY_SESSION_ID="$(
    read_required_env_value "$STATE_FILE" "RECOVERY_SESSION_ID"
  )"
  RECOVERY_INSTANCE="$(read_required_env_value "$STATE_FILE" "RECOVERY_INSTANCE")"
  RECOVERY_STARTED_AT="$(
    read_required_env_value "$STATE_FILE" "RECOVERY_STARTED_AT"
  )"
  RECOVERY_BREAK_GLASS_GENERATED_AT="$(
    read_required_env_value "$STATE_FILE" "RECOVERY_BREAK_GLASS_GENERATED_AT"
  )"
  RECOVERY_INFRA_REPOSITORY_URL="$(
    read_required_env_value "$STATE_FILE" "RECOVERY_INFRA_REPOSITORY_URL"
  )"
  RECOVERY_INFRA_REPOSITORY_REF="$(
    read_required_env_value "$STATE_FILE" "RECOVERY_INFRA_REPOSITORY_REF"
  )"
  RECOVERY_STATUS="$(read_required_env_value "$STATE_FILE" "RECOVERY_STATUS")"
  RECOVERY_PHASE_REPOSITORY="$(
    read_required_env_value "$STATE_FILE" "RECOVERY_PHASE_REPOSITORY"
  )"
  RECOVERY_PHASE_CONFIG="$(
    read_required_env_value "$STATE_FILE" "RECOVERY_PHASE_CONFIG"
  )"
  RECOVERY_CONFIG_SNAPSHOT="$(
    read_required_env_value "$STATE_FILE" "RECOVERY_CONFIG_SNAPSHOT"
  )"
  RECOVERY_PHASE_DATA="$(
    read_required_env_value "$STATE_FILE" "RECOVERY_PHASE_DATA"
  )"
  RECOVERY_DATA_SNAPSHOT="$(
    read_required_env_value "$STATE_FILE" "RECOVERY_DATA_SNAPSHOT"
  )"
  RECOVERY_PHASE_PROJECTS="$(
    read_required_env_value "$STATE_FILE" "RECOVERY_PHASE_PROJECTS"
  )"
  RECOVERY_PHASE_FINALIZE="$(
    read_required_env_value "$STATE_FILE" "RECOVERY_PHASE_FINALIZE"
  )"

  [[ "$RECOVERY_STATE_VERSION" == "$STATE_VERSION" ]] || \
    fail "Unsupported recovery state version"
  [[ "$RECOVERY_SESSION_ID" =~ \
    ^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{8}T[0-9]{6}Z$ ]] || \
    fail "Invalid recovery session ID"
  [[ "$RECOVERY_INSTANCE" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || \
    fail "Invalid recovery instance"
  [[ "$RECOVERY_STARTED_AT" =~ \
    ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || \
    fail "Invalid recovery start time"
  [[ "$RECOVERY_BREAK_GLASS_GENERATED_AT" =~ \
    ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || \
    fail "Invalid break-glass generation time in recovery state"
  validate_repository_url "$RECOVERY_INFRA_REPOSITORY_URL"
  [[ "$RECOVERY_INFRA_REPOSITORY_REF" =~ ^[0-9a-f]{40}$ || \
    "$RECOVERY_INFRA_REPOSITORY_REF" =~ ^[0-9a-f]{64}$ ]] || \
    fail "Invalid infrastructure commit in recovery state"
  [[ "$RECOVERY_STATUS" == "in-progress" || \
    "$RECOVERY_STATUS" == "complete" ]] || \
    fail "Invalid overall recovery status"

  for phase in \
    "$RECOVERY_PHASE_REPOSITORY" \
    "$RECOVERY_PHASE_CONFIG" \
    "$RECOVERY_PHASE_DATA" \
    "$RECOVERY_PHASE_PROJECTS" \
    "$RECOVERY_PHASE_FINALIZE"; do
    [[ "$phase" == "pending" || "$phase" == "in-progress" || \
      "$phase" == "complete" ]] || \
      fail "Invalid recovery phase state"
  done

  [[ "$RECOVERY_PHASE_REPOSITORY" == "complete" ]] || \
    fail "Repository phase must be complete in an initialized session"
  if [[ "$RECOVERY_PHASE_CONFIG" == "pending" ]]; then
    [[ -z "$RECOVERY_CONFIG_SNAPSHOT" ]] || \
      fail "Pending configuration phase must not have a snapshot ID"
  else
    [[ "$RECOVERY_CONFIG_SNAPSHOT" =~ ^[0-9a-f]{8,64}$ ]] || \
      fail "Started configuration phase requires an exact snapshot ID"
  fi
  if [[ "$RECOVERY_PHASE_DATA" == "pending" ]]; then
    [[ -z "$RECOVERY_DATA_SNAPSHOT" ]] || \
      fail "Pending data phase must not have a snapshot ID"
  else
    [[ "$RECOVERY_PHASE_CONFIG" == "complete" ]] || \
      fail "Started data phase requires completed configuration"
    [[ "$RECOVERY_DATA_SNAPSHOT" =~ ^[0-9a-f]{8,64}$ ]] || \
      fail "Started data phase requires an exact snapshot ID"
  fi
  if [[ "$RECOVERY_PHASE_PROJECTS" != "pending" ]]; then
    [[ "$RECOVERY_PHASE_DATA" == "complete" ]] || \
      fail "Started projects phase requires a completed data phase"
  fi
  if [[ "$RECOVERY_PHASE_FINALIZE" != "pending" ]]; then
    [[ "$RECOVERY_PHASE_PROJECTS" == "complete" ]] || \
      fail "Started finalize phase requires completed projects"
  fi
  if [[ "$RECOVERY_PHASE_FINALIZE" == "complete" ]]; then
    [[ "$RECOVERY_STATUS" == "complete" ]] || \
      fail "Completed finalization requires complete overall status"
  else
    [[ "$RECOVERY_STATUS" == "in-progress" ]] || \
      fail "In-progress finalization requires in-progress overall status"
  fi
}

validate_state_storage() {
  local expected_owner

  [[ -d "$STATE_ROOT" && ! -L "$STATE_ROOT" ]] || \
    fail "Recovery state root is not a regular directory"
  [[ "$(file_mode "$STATE_ROOT")" == "700" ]] || \
    fail "Recovery state root must have mode 0700"
  expected_owner="$(id -u)"
  [[ "$(file_owner_id "$STATE_ROOT")" == "$expected_owner" ]] || \
    fail "Recovery state root must belong to the invoking user"
}

ensure_state_root() {
  validate_state_root
  if [[ -e "$STATE_ROOT" || -L "$STATE_ROOT" ]]; then
    [[ -d "$STATE_ROOT" && ! -L "$STATE_ROOT" ]] || \
      fail "Recovery state root is not a regular directory"
    [[ "$(file_owner_id "$STATE_ROOT")" == "$(id -u)" ]] || \
      fail "Recovery state root must belong to the invoking user"
  else
    mkdir -p "$STATE_ROOT"
  fi
  chmod 0700 "$STATE_ROOT"
  validate_state_storage
  STATE_FILE="$STATE_ROOT/session.env"
}

locate_state_root() {
  validate_state_root
  validate_state_storage
  STATE_FILE="$STATE_ROOT/session.env"
}

write_state_file() {
  local active_state_file="$STATE_FILE"

  [[ -f "$active_state_file" && ! -L "$active_state_file" ]] || \
    fail "Recovery state file is not a regular file"
  umask 077
  TEMP_FILE="$(mktemp "$STATE_ROOT/.session.env.XXXXXX")"

  {
    printf '%s\n' "RECOVERY_STATE_VERSION=$RECOVERY_STATE_VERSION"
    printf '%s\n' "RECOVERY_SESSION_ID=$RECOVERY_SESSION_ID"
    printf '%s\n' "RECOVERY_INSTANCE=$RECOVERY_INSTANCE"
    printf '%s\n' "RECOVERY_STARTED_AT=$RECOVERY_STARTED_AT"
    printf '%s\n' \
      "RECOVERY_BREAK_GLASS_GENERATED_AT=$RECOVERY_BREAK_GLASS_GENERATED_AT"
    printf '%s\n' \
      "RECOVERY_INFRA_REPOSITORY_URL=$RECOVERY_INFRA_REPOSITORY_URL"
    printf '%s\n' \
      "RECOVERY_INFRA_REPOSITORY_REF=$RECOVERY_INFRA_REPOSITORY_REF"
    printf '%s\n' "RECOVERY_STATUS=$RECOVERY_STATUS"
    printf '%s\n' "RECOVERY_PHASE_REPOSITORY=$RECOVERY_PHASE_REPOSITORY"
    printf '%s\n' "RECOVERY_PHASE_CONFIG=$RECOVERY_PHASE_CONFIG"
    printf '%s\n' "RECOVERY_CONFIG_SNAPSHOT=$RECOVERY_CONFIG_SNAPSHOT"
    printf '%s\n' "RECOVERY_PHASE_DATA=$RECOVERY_PHASE_DATA"
    printf '%s\n' "RECOVERY_DATA_SNAPSHOT=$RECOVERY_DATA_SNAPSHOT"
    printf '%s\n' "RECOVERY_PHASE_PROJECTS=$RECOVERY_PHASE_PROJECTS"
    printf '%s\n' "RECOVERY_PHASE_FINALIZE=$RECOVERY_PHASE_FINALIZE"
  } > "$TEMP_FILE"
  chmod 0600 "$TEMP_FILE"

  STATE_FILE="$TEMP_FILE"
  validate_state_file
  STATE_FILE="$active_state_file"
  mv -f -- "$TEMP_FILE" "$STATE_FILE"
  TEMP_FILE=""
}

release_recovery_lock() {
  if [[ -n "$LOCK_DIR" && -d "$LOCK_DIR" ]]; then
    if [[ -f "$LOCK_DIR/pid" && ! -L "$LOCK_DIR/pid" ]]; then
      rm -f -- "$LOCK_DIR/pid"
    fi
    rmdir "$LOCK_DIR" 2>/dev/null || \
      recovery_warn "Unable to release recovery operation lock"
  fi
  LOCK_DIR=""
}

acquire_recovery_lock() {
  local lock_pid=""

  LOCK_DIR="$STATE_ROOT/operation.lock"
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    [[ -d "$LOCK_DIR" && ! -L "$LOCK_DIR" ]] || \
      fail "Recovery operation lock is not a regular directory"
    if [[ -f "$LOCK_DIR/pid" && ! -L "$LOCK_DIR/pid" ]]; then
      IFS= read -r lock_pid < "$LOCK_DIR/pid" || true
    fi
    if [[ "$lock_pid" =~ ^[1-9][0-9]*$ ]] && \
      kill -0 "$lock_pid" 2>/dev/null; then
      fail "Another recovery operation is running"
    fi
    recovery_warn "Removing stale recovery operation lock"
    [[ ! -e "$LOCK_DIR/pid" || \
      (-f "$LOCK_DIR/pid" && ! -L "$LOCK_DIR/pid") ]] || \
      fail "Recovery operation lock contains an unsafe PID file"
    rm -f -- "$LOCK_DIR/pid"
    rmdir "$LOCK_DIR" 2>/dev/null || \
      fail "Recovery operation lock contains unexpected data"
    mkdir "$LOCK_DIR" || fail "Unable to acquire recovery operation lock"
  fi
  chmod 0700 "$LOCK_DIR"
  umask 077
  printf '%s\n' "$$" > "$LOCK_DIR/pid"
  chmod 0600 "$LOCK_DIR/pid"
}

cleanup() {
  local cleanup_status=0

  if [[ -n "$PROJECT_INSTALL_TEMP" && -d "$PROJECT_INSTALL_TEMP" && \
    -n "${RECOVERY_SESSION_ID:-}" && \
    "$PROJECT_INSTALL_TEMP" == \
      */.*.files-recovery-"$RECOVERY_SESSION_ID".* && \
    ! -L "$PROJECT_INSTALL_TEMP" ]]; then
    rm -rf -- "$PROJECT_INSTALL_TEMP"
  fi
  PROJECT_INSTALL_TEMP=""

  if [[ -n "$PROJECT_RESTORE_TARGET" && \
    -d "$PROJECT_RESTORE_TARGET" && \
    -n "${RECOVERY_SESSION_ID:-}" && \
    "$PROJECT_RESTORE_TARGET" == \
      "$WORK_ROOT/project-files-"*-"$RECOVERY_SESSION_ID" && \
    ! -L "$PROJECT_RESTORE_TARGET" ]]; then
    rm -rf -- "$PROJECT_RESTORE_TARGET"
  fi
  PROJECT_RESTORE_TARGET=""

  if [[ -n "$PROJECT_CLONE_TEMP" && -d "$PROJECT_CLONE_TEMP" && \
    -n "${RECOVERY_SESSION_ID:-}" && \
    "$PROJECT_CLONE_TEMP" == */.*.recovery-"$RECOVERY_SESSION_ID".* && \
    ! -L "$PROJECT_CLONE_TEMP" ]]; then
    rm -rf -- "$PROJECT_CLONE_TEMP"
  fi
  PROJECT_CLONE_TEMP=""

  if [[ "$CONFIG_INSTALLED_BY_RUN" == "1" && \
    -n "$CONFIG_ROOT" && -d "$CONFIG_ROOT" && \
    -n "$INSTALL_TEMP" && ! -e "$INSTALL_TEMP" ]]; then
    if ! mv -- "$CONFIG_ROOT" "$INSTALL_TEMP"; then
      recovery_warn "Unable to roll back configuration installed by failed recovery"
      cleanup_status=1
    fi
  fi
  CONFIG_INSTALLED_BY_RUN=0

  if [[ -n "$INSTALL_TEMP" && -d "$INSTALL_TEMP" && \
    "$INSTALL_TEMP" == "${CONFIG_ROOT%/*}/.${CONFIG_ROOT##*/}.recovery-"* && \
    ! -L "$INSTALL_TEMP" ]]; then
    rm -rf -- "$INSTALL_TEMP"
  fi
  INSTALL_TEMP=""

  if [[ -n "$RESTORE_TARGET" && -d "$RESTORE_TARGET" && \
    "$RESTORE_TARGET" == "$WORK_ROOT/config-restore-"* && \
    ! -L "$RESTORE_TARGET" ]]; then
    rm -rf -- "$RESTORE_TARGET"
  fi
  RESTORE_TARGET=""

  if [[ -n "$TEMP_FILE" && -f "$TEMP_FILE" ]]; then
    rm -f -- "$TEMP_FILE"
  fi
  TEMP_FILE=""
  release_recovery_lock || cleanup_status=1
  return "$cleanup_status"
}

run_init() {
  local started_at
  local session_id

  [[ -n "$BREAK_GLASS_FILE" ]] || fail "init requires --break-glass"
  validate_secret_record_file "$BREAK_GLASS_FILE"
  read_break_glass "$BREAK_GLASS_FILE"
  validate_current_repository
  ensure_state_root

  if [[ -e "$STATE_FILE" || -L "$STATE_FILE" ]]; then
    validate_state_file
    [[ "$RECOVERY_INSTANCE" == "$BREAK_GLASS_INSTANCE" ]] || \
      fail "Existing recovery session belongs to another server"
    [[ "$RECOVERY_INFRA_REPOSITORY_URL" == \
      "$BREAK_GLASS_REPOSITORY_URL" ]] || \
      fail "Existing recovery session uses another repository"
    [[ "$RECOVERY_INFRA_REPOSITORY_REF" == \
      "$BREAK_GLASS_REPOSITORY_REF" ]] || \
      fail "Existing recovery session uses another infrastructure commit"
    [[ "$RECOVERY_BREAK_GLASS_GENERATED_AT" == \
      "$BREAK_GLASS_GENERATED_AT" ]] || \
      fail "Existing recovery session uses another break-glass record"
    recovery_ok "recovery session already initialized: $RECOVERY_SESSION_ID"
    return
  fi

  started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  session_id="$BREAK_GLASS_INSTANCE-$(date -u +%Y%m%dT%H%M%SZ)"
  umask 077
  TEMP_FILE="$(mktemp "$STATE_ROOT/.session.env.XXXXXX")"
  trap cleanup EXIT

  {
    printf '%s\n' "RECOVERY_STATE_VERSION=$STATE_VERSION"
    printf '%s\n' "RECOVERY_SESSION_ID=$session_id"
    printf '%s\n' "RECOVERY_INSTANCE=$BREAK_GLASS_INSTANCE"
    printf '%s\n' "RECOVERY_STARTED_AT=$started_at"
    printf '%s\n' \
      "RECOVERY_BREAK_GLASS_GENERATED_AT=$BREAK_GLASS_GENERATED_AT"
    printf '%s\n' \
      "RECOVERY_INFRA_REPOSITORY_URL=$BREAK_GLASS_REPOSITORY_URL"
    printf '%s\n' \
      "RECOVERY_INFRA_REPOSITORY_REF=$BREAK_GLASS_REPOSITORY_REF"
    printf '%s\n' "RECOVERY_STATUS=in-progress"
    printf '%s\n' "RECOVERY_PHASE_REPOSITORY=complete"
    printf '%s\n' "RECOVERY_PHASE_CONFIG=pending"
    printf '%s\n' "RECOVERY_CONFIG_SNAPSHOT="
    printf '%s\n' "RECOVERY_PHASE_DATA=pending"
    printf '%s\n' "RECOVERY_DATA_SNAPSHOT="
    printf '%s\n' "RECOVERY_PHASE_PROJECTS=pending"
    printf '%s\n' "RECOVERY_PHASE_FINALIZE=pending"
  } > "$TEMP_FILE"

  chmod 0600 "$TEMP_FILE"
  if ! ln "$TEMP_FILE" "$STATE_FILE"; then
    fail "Unable to create recovery state without overwriting existing data"
  fi
  rm -f -- "$TEMP_FILE"
  TEMP_FILE=""

  validate_state_file
  recovery_ok "recovery session initialized: $RECOVERY_SESSION_ID"
  recovery_warn "The break-glass file was not copied; keep it available for the restore phase"
}

load_recovery_context() {
  [[ -n "$BREAK_GLASS_FILE" ]] || \
    fail "$OPERATION requires --break-glass"
  validate_secret_record_file "$BREAK_GLASS_FILE"
  read_break_glass "$BREAK_GLASS_FILE"
  validate_current_repository
  locate_state_root
  validate_state_file

  [[ "$RECOVERY_INSTANCE" == "$BREAK_GLASS_INSTANCE" ]] || \
    fail "Recovery session belongs to another server"
  [[ "$RECOVERY_BREAK_GLASS_GENERATED_AT" == \
    "$BREAK_GLASS_GENERATED_AT" ]] || \
    fail "Recovery session uses another break-glass record"
  [[ "$RECOVERY_INFRA_REPOSITORY_URL" == \
    "$BREAK_GLASS_REPOSITORY_URL" ]] || \
    fail "Recovery session uses another infrastructure repository"
  [[ "$RECOVERY_INFRA_REPOSITORY_REF" == \
    "$BREAK_GLASS_REPOSITORY_REF" ]] || \
    fail "Recovery session uses another infrastructure commit"
}

paths_overlap() {
  local first="${1%/}"
  local second="${2%/}"

  [[ "$first" == "$second" || "$first" == "$second"/* || \
    "$second" == "$first"/* ]]
}

validate_config_destination() {
  local config_parent="${CONFIG_ROOT%/*}"
  local physical_repository_root

  [[ -n "$config_parent" ]] || config_parent="/"
  validate_config_root_path "$CONFIG_ROOT"
  validate_absolute_path "$CONFIG_ROOT" "Configuration root"
  validate_no_symlink_components "$CONFIG_ROOT" "Configuration root"
  [[ -d "$config_parent" && ! -L "$config_parent" ]] || \
    fail "Configuration parent directory not found: $config_parent"

  physical_repository_root="$(cd "$REPOSITORY_ROOT" && pwd -P)"
  ! paths_overlap "$CONFIG_ROOT" "$physical_repository_root" || \
    fail "Configuration root must be outside the server-infra repository"
  ! paths_overlap "$CONFIG_ROOT" "$STATE_ROOT" || \
    fail "Configuration root must not overlap recovery state"

  if [[ "$(uname -s)" == "Linux" && \
    "${CONFIG_ROOT%/}" == "/etc/server-infra" && "$(id -u)" != "0" ]]; then
    fail "Default configuration restore must run as root"
  fi
}

validate_work_root() {
  local normalized_root="${WORK_ROOT%/}"
  local physical_repository_root

  validate_absolute_path "$WORK_ROOT" "Recovery work root"
  case "$normalized_root" in
    "" | / | /var | /var/cache | /etc | /run | /tmp | /home | /root | /usr | /opt)
      fail "Refusing unsafe recovery work root: $WORK_ROOT"
      ;;
  esac
  validate_no_symlink_components "$WORK_ROOT" "Recovery work root"
  physical_repository_root="$(cd "$REPOSITORY_ROOT" && pwd -P)"
  ! paths_overlap "$WORK_ROOT" "$physical_repository_root" || \
    fail "Recovery work root must be outside the server-infra repository"
  ! paths_overlap "$WORK_ROOT" "$STATE_ROOT" || \
    fail "Recovery work root must not overlap recovery state"
  ! paths_overlap "$WORK_ROOT" "$CONFIG_ROOT" || \
    fail "Recovery work root must not overlap active configuration"
}

ensure_work_root() {
  validate_work_root
  if [[ -e "$WORK_ROOT" || -L "$WORK_ROOT" ]]; then
    [[ -d "$WORK_ROOT" && ! -L "$WORK_ROOT" ]] || \
      fail "Recovery work root is not a regular directory"
    [[ "$(file_owner_id "$WORK_ROOT")" == "$(id -u)" ]] || \
      fail "Recovery work root must belong to the invoking user"
  else
    mkdir -p "$WORK_ROOT"
  fi
  chmod 0700 "$WORK_ROOT"
  [[ "$(file_mode "$WORK_ROOT")" == "700" ]] || \
    fail "Recovery work root must have mode 0700"
}

run_break_glass_restic() {
  if [[ -n "${ACTIVE_RESTIC_CACHE:-}" ]]; then
    RESTIC_REPOSITORY="$BREAK_GLASS_RESTIC_REPOSITORY" \
    RESTIC_PASSWORD="$BREAK_GLASS_RESTIC_PASSWORD" \
    AWS_ACCESS_KEY_ID="$BREAK_GLASS_AWS_ACCESS_KEY_ID" \
    AWS_SECRET_ACCESS_KEY="$BREAK_GLASS_AWS_SECRET_ACCESS_KEY" \
    AWS_DEFAULT_REGION="$BREAK_GLASS_AWS_DEFAULT_REGION" \
    RESTIC_CACHE_DIR="$ACTIVE_RESTIC_CACHE" \
      restic "$@"
  else
    RESTIC_REPOSITORY="$BREAK_GLASS_RESTIC_REPOSITORY" \
    RESTIC_PASSWORD="$BREAK_GLASS_RESTIC_PASSWORD" \
    AWS_ACCESS_KEY_ID="$BREAK_GLASS_AWS_ACCESS_KEY_ID" \
    AWS_SECRET_ACCESS_KEY="$BREAK_GLASS_AWS_SECRET_ACCESS_KEY" \
    AWS_DEFAULT_REGION="$BREAK_GLASS_AWS_DEFAULT_REGION" \
      restic "$@"
  fi
}

read_single_line_secret() {
  local file_path="$1"
  local line_count
  local value=""

  [[ -f "$file_path" && ! -L "$file_path" && -r "$file_path" ]] || \
    fail "Restored restic password file is missing or unsafe"
  line_count="$(awk 'END { print NR }' "$file_path")"
  [[ "$line_count" == "1" ]] || \
    fail "Restored restic password file must contain exactly one line"
  IFS= read -r value < "$file_path" || [[ -n "$value" ]] || \
    fail "Restored restic password file is empty"
  printf '%s' "$value"
}

validate_recovered_configuration() {
  local recovered_root="$1"
  local runtime_file="$recovered_root/backup/runtime.env"
  local password_file="$recovered_root/backup/restic-password"
  local unsafe_entry
  local restored_instance
  local configured_password_file
  local restored_password

  [[ -d "$recovered_root" && ! -L "$recovered_root" ]] || \
    fail "Restored configuration root not found"
  unsafe_entry="$(
    find "$recovered_root" ! -type d ! -type f -print -quit
  )"
  [[ -z "$unsafe_entry" ]] || \
    fail "Restored configuration contains a symlink or special file"

  "$REPOSITORY_ROOT/scripts/validate-config.sh" \
    --config-root "$recovered_root" >/dev/null

  restored_instance="$(
    read_required_env_value "$recovered_root/server.env" "SERVER_INFRA_INSTANCE"
  )"
  [[ "$restored_instance" == "$BREAK_GLASS_INSTANCE" ]] || \
    fail "Restored configuration belongs to another server"

  [[ "$(read_required_env_value "$runtime_file" "RESTIC_REPOSITORY")" == \
    "$BREAK_GLASS_RESTIC_REPOSITORY" ]] || \
    fail "Restored RESTIC_REPOSITORY differs from the break-glass record"
  [[ "$(read_required_env_value "$runtime_file" "AWS_ACCESS_KEY_ID")" == \
    "$BREAK_GLASS_AWS_ACCESS_KEY_ID" ]] || \
    fail "Restored AWS_ACCESS_KEY_ID differs from the break-glass record"
  [[ "$(read_required_env_value "$runtime_file" "AWS_SECRET_ACCESS_KEY")" == \
    "$BREAK_GLASS_AWS_SECRET_ACCESS_KEY" ]] || \
    fail "Restored AWS_SECRET_ACCESS_KEY differs from the break-glass record"
  [[ "$(read_required_env_value "$runtime_file" "AWS_DEFAULT_REGION")" == \
    "$BREAK_GLASS_AWS_DEFAULT_REGION" ]] || \
    fail "Restored AWS_DEFAULT_REGION differs from the break-glass record"

  configured_password_file="$(
    read_required_env_value "$runtime_file" "RESTIC_PASSWORD_FILE"
  )"
  [[ "$configured_password_file" == \
    "${CONFIG_ROOT%/}/backup/restic-password" ]] || \
    fail "Restored RESTIC_PASSWORD_FILE does not match the active configuration path"
  [[ "$(file_mode "$password_file")" == "600" ]] || \
    fail "Restored restic password file must have mode 0600"
  [[ "$(file_owner_id "$password_file")" == "$(id -u)" ]] || \
    fail "Restored restic password file must belong to the invoking user"
  restored_password="$(read_single_line_secret "$password_file")"
  [[ "$restored_password" == "$BREAK_GLASS_RESTIC_PASSWORD" ]] || \
    fail "Restored restic password differs from the break-glass record"
}

validate_live_configuration() {
  validate_recovered_configuration "$CONFIG_ROOT"
  "$REPOSITORY_ROOT/backup/bin/server-infra-backup" \
    --config-root "$CONFIG_ROOT" \
    validate --allow-missing-project-paths >/dev/null
  "$REPOSITORY_ROOT/backup/bin/server-infra-backup" \
    project recovery-list --config-root "$CONFIG_ROOT" >/dev/null
}

run_config_snapshots() {
  load_recovery_context
  require_command restic

  recovery_log "Configuration snapshots for $RECOVERY_INSTANCE"
  run_break_glass_restic \
    --no-cache \
    snapshots \
    --host "$RECOVERY_INSTANCE" \
    --tag server-infra-config
}

run_restore_config() {
  local restored_config
  local restic_cache

  [[ "$SNAPSHOT_ID" =~ ^[0-9a-f]{8,64}$ ]] || \
    fail "restore-config requires an exact 8-64 character lowercase hex snapshot ID"
  load_recovery_context
  validate_config_destination
  validate_work_root
  require_command awk
  require_command cp
  require_command find
  require_command restic

  acquire_recovery_lock
  trap cleanup EXIT
  validate_state_file

  if [[ "$RECOVERY_PHASE_CONFIG" == "complete" ]]; then
    [[ "$RECOVERY_CONFIG_SNAPSHOT" == "$SNAPSHOT_ID" ]] || \
      fail "Configuration was already restored from another snapshot"
    [[ -d "$CONFIG_ROOT" && ! -L "$CONFIG_ROOT" ]] || \
      fail "Completed recovery state is missing active configuration"
    validate_live_configuration
    recovery_ok "configuration snapshot already restored: $SNAPSHOT_ID"
    return
  fi

  if [[ "$RECOVERY_PHASE_CONFIG" == "pending" ]]; then
    [[ ! -e "$CONFIG_ROOT" && ! -L "$CONFIG_ROOT" ]] || \
      fail "Active configuration already exists; refusing to overwrite it"
    RECOVERY_PHASE_CONFIG="in-progress"
    RECOVERY_CONFIG_SNAPSHOT="$SNAPSHOT_ID"
    write_state_file
  else
    [[ "$RECOVERY_PHASE_CONFIG" == "in-progress" ]] || \
      fail "Configuration restore is in an unsupported state"
    [[ "$RECOVERY_CONFIG_SNAPSHOT" == "$SNAPSHOT_ID" ]] || \
      fail "Configuration restore is already pinned to another snapshot"
  fi

  if [[ -e "$CONFIG_ROOT" || -L "$CONFIG_ROOT" ]]; then
    [[ -d "$CONFIG_ROOT" && ! -L "$CONFIG_ROOT" ]] || \
      fail "Active configuration path is not a regular directory"
    validate_live_configuration
    RECOVERY_PHASE_CONFIG="complete"
    write_state_file
    recovery_ok "existing installed configuration validated after resume"
    return
  fi

  ensure_work_root
  RESTORE_TARGET="$WORK_ROOT/config-restore-$RECOVERY_SESSION_ID"
  INSTALL_TEMP="${CONFIG_ROOT%/*}/.${CONFIG_ROOT##*/}.recovery-$RECOVERY_SESSION_ID"
  if [[ -e "$RESTORE_TARGET" || -L "$RESTORE_TARGET" ]]; then
    [[ -d "$RESTORE_TARGET" && ! -L "$RESTORE_TARGET" ]] || \
      fail "Managed restore target is not a regular directory"
    rm -rf -- "$RESTORE_TARGET"
  fi
  if [[ -e "$INSTALL_TEMP" || -L "$INSTALL_TEMP" ]]; then
    [[ -d "$INSTALL_TEMP" && ! -L "$INSTALL_TEMP" ]] || \
      fail "Managed configuration staging path is not a regular directory"
    rm -rf -- "$INSTALL_TEMP"
  fi
  mkdir -m 0700 "$RESTORE_TARGET"
  restic_cache="$WORK_ROOT/restic-cache"
  mkdir -p "$restic_cache"
  chmod 0700 "$restic_cache"
  ACTIVE_RESTIC_CACHE="$restic_cache"

  recovery_log "Restoring configuration snapshot $SNAPSHOT_ID"
  run_break_glass_restic \
    restore "$SNAPSHOT_ID" \
    --host "$RECOVERY_INSTANCE" \
    --tag server-infra-config \
    --target "$RESTORE_TARGET"

  restored_config="$RESTORE_TARGET$CONFIG_ROOT"
  validate_recovered_configuration "$restored_config"
  cp -a "$restored_config" "$INSTALL_TEMP"
  validate_recovered_configuration "$INSTALL_TEMP"

  [[ ! -e "$CONFIG_ROOT" && ! -L "$CONFIG_ROOT" ]] || \
    fail "Active configuration appeared during restore; refusing to overwrite it"
  mv -n -- "$INSTALL_TEMP" "$CONFIG_ROOT"
  [[ -d "$CONFIG_ROOT" && ! -e "$INSTALL_TEMP" ]] || \
    fail "Unable to install configuration without overwriting existing data"
  CONFIG_INSTALLED_BY_RUN=1

  validate_live_configuration
  RECOVERY_PHASE_CONFIG="complete"
  write_state_file
  CONFIG_INSTALLED_BY_RUN=0

  recovery_ok "configuration restored and validated from snapshot $SNAPSHOT_ID"
  recovery_warn "Project data and public traffic remain untouched"
}

validate_configuration_phase_complete() {
  [[ "$RECOVERY_PHASE_CONFIG" == "complete" ]] || \
    fail "Configuration recovery must complete before selecting project data"
  [[ -d "$CONFIG_ROOT" && ! -L "$CONFIG_ROOT" ]] || \
    fail "Completed recovery state is missing active configuration"
  validate_config_destination
  validate_live_configuration
}

run_data_snapshots() {
  load_recovery_context
  validate_configuration_phase_complete
  require_command restic

  recovery_log "Data snapshots for $RECOVERY_INSTANCE"
  run_break_glass_restic \
    --no-cache \
    snapshots \
    --host "$RECOVERY_INSTANCE" \
    --tag server-infra-data
}

run_select_data() {
  local snapshot_listing
  local snapshot_line=""
  local displayed_id
  local snapshot_found=0

  [[ "$SNAPSHOT_ID" =~ ^[0-9a-f]{8,64}$ ]] || \
    fail "select-data requires an exact 8-64 character lowercase hex snapshot ID"
  load_recovery_context
  validate_configuration_phase_complete
  require_command restic

  acquire_recovery_lock
  trap cleanup EXIT
  validate_state_file

  if [[ "$RECOVERY_PHASE_DATA" == "complete" ]]; then
    [[ "$RECOVERY_DATA_SNAPSHOT" == "$SNAPSHOT_ID" ]] || \
      fail "Data snapshot is already pinned to another ID"
    recovery_ok "data snapshot already selected: $SNAPSHOT_ID"
    return
  fi
  [[ "$RECOVERY_PHASE_DATA" == "pending" ]] || \
    fail "Data snapshot selection is in an unsupported state"

  snapshot_listing="$(
    run_break_glass_restic \
      --no-cache \
      snapshots "$SNAPSHOT_ID" \
      --host "$RECOVERY_INSTANCE" \
      --tag server-infra-data
  )"
  while IFS= read -r snapshot_line || [[ -n "$snapshot_line" ]]; do
    if [[ "$snapshot_line" =~ ^([0-9a-f]{8,64})[[:space:]] ]]; then
      displayed_id="${BASH_REMATCH[1]}"
      if [[ "$SNAPSHOT_ID" == "$displayed_id"* || \
        "$displayed_id" == "$SNAPSHOT_ID"* ]]; then
        snapshot_found=1
        break
      fi
    fi
  done <<< "$snapshot_listing"
  [[ "$snapshot_found" == "1" ]] || \
    fail "Selected data snapshot does not match this server and data tag"

  RECOVERY_PHASE_DATA="complete"
  RECOVERY_DATA_SNAPSHOT="$SNAPSHOT_ID"
  write_state_file
  recovery_ok "data snapshot selected for every project: $SNAPSHOT_ID"
}

validate_projects_phase_ready() {
  validate_configuration_phase_complete
  [[ "$RECOVERY_PHASE_DATA" == "complete" ]] || \
    fail "An exact data snapshot must be selected before project recovery"
  [[ -n "$RECOVERY_DATA_SNAPSHOT" ]] || \
    fail "Completed data phase is missing its snapshot ID"
}

load_project_record() {
  local source_dir="$1"
  local source_file="$source_dir/source.conf"
  local recovery_file="$source_dir/recovery.conf"
  local allowed_recovery_keys=$'\nRECOVERY_VERSION\nREPOSITORY_URL\nDEPLOY_COMMIT\n'
  local seen_recovery_keys=$'\n'
  local line=""
  local line_number=0
  local recovery_version
  local project_config_file

  [[ -d "$source_dir" && ! -L "$source_dir" ]] || \
    fail "Project source is not a regular directory: $source_dir"
  [[ "$(file_mode "$source_dir")" == "750" ]] || \
    fail "Project source directory must have mode 0750: $source_dir"
  [[ "$(file_owner_id "$source_dir")" == "$(id -u)" && \
    "$(file_group_id "$source_dir")" == "$(id -g)" ]] || \
    fail "Project source directory has unexpected ownership: $source_dir"
  for project_config_file in \
    "$source_file" \
    "$source_dir/paths" \
    "$source_dir/excludes" \
    "$source_dir/freshness" \
    "$recovery_file"; do
    [[ -f "$project_config_file" && ! -L "$project_config_file" ]] || \
      fail "Project recovery file is missing or unsafe: $project_config_file"
    [[ "$(file_mode "$project_config_file")" == "640" ]] || \
      fail "Project recovery file must have mode 0640: $project_config_file"
    [[ "$(file_owner_id "$project_config_file")" == "$(id -u)" && \
      "$(file_group_id "$project_config_file")" == "$(id -g)" ]] || \
      fail "Project recovery file has unexpected ownership: $project_config_file"
  done
  validate_env_file "$recovery_file"

  while IFS= read -r line || [[ -n "$line" ]]; do
    line_number=$((line_number + 1))
    parse_env_line "$line" "$recovery_file" "$line_number"
    [[ "$PARSED_ENV_KIND" == "assignment" ]] || continue
    [[ "$allowed_recovery_keys" == \
      *$'\n'"$PARSED_ENV_KEY"$'\n'* ]] || \
      fail "Unknown key $PARSED_ENV_KEY in $recovery_file"
    [[ "$seen_recovery_keys" != \
      *$'\n'"$PARSED_ENV_KEY"$'\n'* ]] || \
      fail "Duplicate key $PARSED_ENV_KEY in $recovery_file"
    seen_recovery_keys+="$PARSED_ENV_KEY"$'\n'
  done < "$recovery_file"

  SELECTED_PROJECT_NAME="$(
    read_required_env_value "$source_file" "SOURCE_NAME"
  )"
  SELECTED_PROJECT_TYPE="$(
    read_required_env_value "$source_file" "SOURCE_TYPE"
  )"
  SELECTED_PROJECT_ROOT="$(
    read_required_env_value "$source_file" "PROJECT_ROOT"
  )"
  recovery_version="$(
    read_required_env_value "$recovery_file" "RECOVERY_VERSION"
  )"
  SELECTED_PROJECT_REPOSITORY_URL="$(
    read_required_env_value "$recovery_file" "REPOSITORY_URL"
  )"
  SELECTED_PROJECT_DEPLOY_COMMIT="$(
    read_required_env_value "$recovery_file" "DEPLOY_COMMIT"
  )"

  [[ "$SELECTED_PROJECT_NAME" == "${source_dir##*/}" ]] || \
    fail "Project source directory does not match SOURCE_NAME"
  validate_source_name "$SELECTED_PROJECT_NAME"
  case "$SELECTED_PROJECT_TYPE" in
    files-only | postgres-compose)
      ;;
    *)
      fail "Unsupported project source type: $SELECTED_PROJECT_TYPE"
      ;;
  esac
  validate_absolute_path "$SELECTED_PROJECT_ROOT" "Project root"
  validate_no_symlink_components "$SELECTED_PROJECT_ROOT" "Project root"
  case "${SELECTED_PROJECT_ROOT%/}" in
    "" | / | /etc | /opt | /srv | /home | /root | /usr | /var)
      fail "Refusing unsafe project root: $SELECTED_PROJECT_ROOT"
      ;;
  esac
  ! paths_overlap "$SELECTED_PROJECT_ROOT" "$CONFIG_ROOT" || \
    fail "Project root must not overlap active configuration"
  ! paths_overlap "$SELECTED_PROJECT_ROOT" "$STATE_ROOT" || \
    fail "Project root must not overlap recovery state"
  ! paths_overlap "$SELECTED_PROJECT_ROOT" "$REPOSITORY_ROOT" || \
    fail "Project root must not overlap the server-infra repository"

  [[ "$recovery_version" == "1" ]] || \
    fail "Unsupported RECOVERY_VERSION in $recovery_file"
  validate_repository_url "$SELECTED_PROJECT_REPOSITORY_URL"
  validate_deploy_commit "$SELECTED_PROJECT_DEPLOY_COMMIT"
}

discover_project_inventory() {
  local sources_root="$CONFIG_ROOT/backup/sources.d"
  local source_dirs=()
  local source_dir
  local seen_names=$'\n'
  local seen_roots=$'\n'

  [[ -d "$sources_root" && ! -L "$sources_root" ]] || \
    fail "No recovered project inventory found at $sources_root"

  shopt -s nullglob
  source_dirs=("$sources_root"/*)
  shopt -u nullglob
  ((${#source_dirs[@]} > 0)) || \
    fail "Recovered project inventory is empty"

  for source_dir in "${source_dirs[@]}"; do
    load_project_record "$source_dir"
    [[ "$seen_names" != *$'\n'"$SELECTED_PROJECT_NAME"$'\n'* ]] || \
      fail "Duplicate project name in recovered inventory"
    [[ "$seen_roots" != *$'\n'"$SELECTED_PROJECT_ROOT"$'\n'* ]] || \
      fail "Duplicate project root in recovered inventory"
    seen_names+="$SELECTED_PROJECT_NAME"$'\n'
    seen_roots+="$SELECTED_PROJECT_ROOT"$'\n'
  done
}

select_project_record() {
  local source_dir="$CONFIG_ROOT/backup/sources.d/$PROJECT_NAME"

  validate_source_name "$PROJECT_NAME"
  load_project_record "$source_dir"
  [[ "$SELECTED_PROJECT_NAME" == "$PROJECT_NAME" ]] || \
    fail "Selected project does not match its recovered source"
}

run_git_as_user() {
  local target_uid
  local git_environment=(
    "GIT_TERMINAL_PROMPT=0"
    "GIT_SSH_COMMAND=ssh -o BatchMode=yes"
  )

  target_uid="$(id -u "$GIT_USER")"
  if [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
    validate_absolute_path "$SSH_AUTH_SOCK" "SSH agent socket"
    [[ -S "$SSH_AUTH_SOCK" ]] || \
      fail "SSH_AUTH_SOCK does not point to a socket"
    git_environment+=("SSH_AUTH_SOCK=$SSH_AUTH_SOCK")
  fi

  if [[ "$(id -u)" == "$target_uid" ]]; then
    env "${git_environment[@]}" git "$@"
  else
    [[ "$(id -u)" == "0" ]] || \
      fail "Changing to the Git user requires root"
    require_command sudo
    sudo -H -u "$GIT_USER" -- env "${git_environment[@]}" git "$@"
  fi
}

validate_project_checkout() {
  local project_root="$1"
  local current_url
  local current_ref

  [[ -d "$project_root" && ! -L "$project_root" ]] || \
    fail "Project checkout is not a regular directory: $project_root"
  [[ "$(file_owner_id "$project_root")" == "$(id -u "$GIT_USER")" ]] || \
    fail "Project checkout does not belong to $GIT_USER"
  run_git_as_user -C "$project_root" \
    rev-parse --is-inside-work-tree >/dev/null 2>&1 || \
    fail "Project root is not a Git checkout: $project_root"
  current_url="$(
    run_git_as_user -C "$project_root" remote get-url origin
  )" || fail "Unable to read project origin: $project_root"
  current_ref="$(
    run_git_as_user -C "$project_root" rev-parse HEAD
  )" || fail "Unable to read project commit: $project_root"
  [[ "$current_url" == "$SELECTED_PROJECT_REPOSITORY_URL" ]] || \
    fail "Existing project origin differs from recovered inventory"
  [[ "$current_ref" == "$SELECTED_PROJECT_DEPLOY_COMMIT" ]] || \
    fail "Existing project commit differs from recovered inventory"
  [[ -z "$(
    run_git_as_user -C "$project_root" \
      status --porcelain --untracked-files=no
  )" ]] || fail "Existing project has modified tracked files"
}

validate_project_state_storage() {
  local project_state_root="$STATE_ROOT/projects"

  [[ -d "$project_state_root" && ! -L "$project_state_root" ]] || \
    fail "Project recovery state root is not a regular directory"
  [[ "$(file_mode "$project_state_root")" == "700" ]] || \
    fail "Project recovery state root must have mode 0700"
  [[ "$(file_owner_id "$project_state_root")" == "$(id -u)" && \
    "$(file_group_id "$project_state_root")" == "$(id -g)" ]] || \
    fail "Project recovery state root has unexpected ownership"
}

validate_project_state_file() {
  local allowed_keys=$'\nPROJECT_RECOVERY_STATE_VERSION\nPROJECT_NAME\nPROJECT_DATA_SNAPSHOT\nPROJECT_FILES_STATUS\nPROJECT_DATABASE_STATUS\n'
  local seen_keys=$'\n'
  local line=""
  local line_number=0

  [[ -f "$PROJECT_STATE_FILE" && ! -L "$PROJECT_STATE_FILE" ]] || \
    fail "Project recovery state is not a regular file"
  [[ "$(file_mode "$PROJECT_STATE_FILE")" == "600" ]] || \
    fail "Project recovery state must have mode 0600"
  [[ "$(file_owner_id "$PROJECT_STATE_FILE")" == "$(id -u)" && \
    "$(file_group_id "$PROJECT_STATE_FILE")" == "$(id -g)" ]] || \
    fail "Project recovery state has unexpected ownership"
  validate_env_file "$PROJECT_STATE_FILE"

  while IFS= read -r line || [[ -n "$line" ]]; do
    line_number=$((line_number + 1))
    parse_env_line "$line" "$PROJECT_STATE_FILE" "$line_number"
    [[ "$PARSED_ENV_KIND" == "assignment" ]] || continue
    [[ "$allowed_keys" == *$'\n'"$PARSED_ENV_KEY"$'\n'* ]] || \
      fail "Unknown key $PARSED_ENV_KEY in project recovery state"
    [[ "$seen_keys" != *$'\n'"$PARSED_ENV_KEY"$'\n'* ]] || \
      fail "Duplicate key $PARSED_ENV_KEY in project recovery state"
    seen_keys+="$PARSED_ENV_KEY"$'\n'
  done < "$PROJECT_STATE_FILE"

  PROJECT_RECOVERY_STATE_VERSION="$(
    read_required_env_value \
      "$PROJECT_STATE_FILE" \
      "PROJECT_RECOVERY_STATE_VERSION"
  )"
  PROJECT_STATE_NAME="$(
    read_required_env_value "$PROJECT_STATE_FILE" "PROJECT_NAME"
  )"
  PROJECT_STATE_DATA_SNAPSHOT="$(
    read_required_env_value "$PROJECT_STATE_FILE" "PROJECT_DATA_SNAPSHOT"
  )"
  PROJECT_FILES_STATUS="$(
    read_required_env_value "$PROJECT_STATE_FILE" "PROJECT_FILES_STATUS"
  )"
  PROJECT_DATABASE_STATUS="$(
    read_required_env_value "$PROJECT_STATE_FILE" "PROJECT_DATABASE_STATUS"
  )"

  [[ "$PROJECT_RECOVERY_STATE_VERSION" == "1" ]] || \
    fail "Unsupported project recovery state version"
  [[ "$PROJECT_STATE_NAME" == "$SELECTED_PROJECT_NAME" ]] || \
    fail "Project recovery state belongs to another project"
  [[ "$PROJECT_STATE_DATA_SNAPSHOT" == "$RECOVERY_DATA_SNAPSHOT" ]] || \
    fail "Project recovery state uses another data snapshot"
  case "$PROJECT_FILES_STATUS" in
    pending | in-progress | complete)
      ;;
    *)
      fail "Invalid project files recovery status"
      ;;
  esac
  case "$PROJECT_DATABASE_STATUS" in
    not-applicable | pending | in-progress | complete)
      ;;
    *)
      fail "Invalid project database recovery status"
      ;;
  esac
  if [[ "$SELECTED_PROJECT_TYPE" == "files-only" ]]; then
    [[ "$PROJECT_DATABASE_STATUS" == "not-applicable" ]] || \
      fail "Files-only project must not have database recovery state"
  else
    [[ "$PROJECT_DATABASE_STATUS" != "not-applicable" ]] || \
      fail "PostgreSQL project is missing database recovery state"
  fi
}

write_project_state_file() {
  local active_project_state_file="$PROJECT_STATE_FILE"

  [[ -f "$active_project_state_file" && \
    ! -L "$active_project_state_file" ]] || \
    fail "Project recovery state file is not a regular file"
  umask 077
  TEMP_FILE="$(
    mktemp "$STATE_ROOT/projects/.${SELECTED_PROJECT_NAME}.env.XXXXXX"
  )"
  {
    printf '%s\n' \
      "PROJECT_RECOVERY_STATE_VERSION=$PROJECT_RECOVERY_STATE_VERSION"
    printf '%s\n' "PROJECT_NAME=$PROJECT_STATE_NAME"
    printf '%s\n' "PROJECT_DATA_SNAPSHOT=$PROJECT_STATE_DATA_SNAPSHOT"
    printf '%s\n' "PROJECT_FILES_STATUS=$PROJECT_FILES_STATUS"
    printf '%s\n' "PROJECT_DATABASE_STATUS=$PROJECT_DATABASE_STATUS"
  } > "$TEMP_FILE"
  chmod 0600 "$TEMP_FILE"

  PROJECT_STATE_FILE="$TEMP_FILE"
  validate_project_state_file
  PROJECT_STATE_FILE="$active_project_state_file"
  mv -f -- "$TEMP_FILE" "$PROJECT_STATE_FILE"
  TEMP_FILE=""
}

ensure_project_state() {
  local project_state_root="$STATE_ROOT/projects"
  local initial_database_status

  if [[ -e "$project_state_root" || -L "$project_state_root" ]]; then
    validate_project_state_storage
  else
    mkdir -m 0700 "$project_state_root"
  fi
  validate_project_state_storage
  PROJECT_STATE_FILE="$project_state_root/$SELECTED_PROJECT_NAME.env"

  if [[ -e "$PROJECT_STATE_FILE" || -L "$PROJECT_STATE_FILE" ]]; then
    validate_project_state_file
    return
  fi

  initial_database_status="not-applicable"
  if [[ "$SELECTED_PROJECT_TYPE" == "postgres-compose" ]]; then
    initial_database_status="pending"
  fi
  umask 077
  TEMP_FILE="$(
    mktemp "$project_state_root/.${SELECTED_PROJECT_NAME}.env.XXXXXX"
  )"
  {
    printf '%s\n' "PROJECT_RECOVERY_STATE_VERSION=1"
    printf '%s\n' "PROJECT_NAME=$SELECTED_PROJECT_NAME"
    printf '%s\n' "PROJECT_DATA_SNAPSHOT=$RECOVERY_DATA_SNAPSHOT"
    printf '%s\n' "PROJECT_FILES_STATUS=pending"
    printf '%s\n' "PROJECT_DATABASE_STATUS=$initial_database_status"
  } > "$TEMP_FILE"
  chmod 0600 "$TEMP_FILE"
  if ! ln "$TEMP_FILE" "$PROJECT_STATE_FILE"; then
    fail "Unable to create project recovery state without overwriting data"
  fi
  rm -f -- "$TEMP_FILE"
  TEMP_FILE=""
  validate_project_state_file
}

refresh_projects_phase() {
  local sources_root="$CONFIG_ROOT/backup/sources.d"
  local source_dirs=()
  local source_dir
  local all_projects_complete=1

  shopt -s nullglob
  source_dirs=("$sources_root"/*)
  shopt -u nullglob
  ((${#source_dirs[@]} > 0)) || \
    fail "Recovered project inventory is empty"

  for source_dir in "${source_dirs[@]}"; do
    load_project_record "$source_dir"
    PROJECT_STATE_FILE="$STATE_ROOT/projects/$SELECTED_PROJECT_NAME.env"
    if [[ ! -f "$PROJECT_STATE_FILE" || -L "$PROJECT_STATE_FILE" ]]; then
      all_projects_complete=0
      continue
    fi
    validate_project_state_storage
    validate_project_state_file
    if [[ "$PROJECT_FILES_STATUS" != "complete" || \
      ("$PROJECT_DATABASE_STATUS" != "complete" && \
      "$PROJECT_DATABASE_STATUS" != "not-applicable") ]]; then
      all_projects_complete=0
    fi
  done

  if [[ "$all_projects_complete" == "1" && \
    "$RECOVERY_PHASE_PROJECTS" != "complete" ]]; then
    RECOVERY_PHASE_PROJECTS="complete"
    write_state_file
  fi
}

load_project_file_paths() {
  local paths_file="$CONFIG_ROOT/backup/sources.d/$PROJECT_NAME/paths"
  local source_file="$CONFIG_ROOT/backup/sources.d/$PROJECT_NAME/source.conf"
  local line=""
  local line_number=0
  local normalized_path
  local staging_dir=""
  local seen_paths=$'\n'

  PROJECT_FILE_PATHS=()
  if [[ "$SELECTED_PROJECT_TYPE" == "postgres-compose" ]]; then
    staging_dir="$(read_required_env_value "$source_file" "STAGING_DIR")"
    staging_dir="${staging_dir%/}"
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    line_number=$((line_number + 1))
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*$ || \
      "$line" =~ ^[[:space:]]*# ]] && continue
    validate_absolute_path \
      "$line" \
      "Project file path in $paths_file at line $line_number"
    normalized_path="${line%/}"
    case "$normalized_path" in
      "" | / | /etc | /opt | /srv | /home | /root | /usr | /var | \
      /tmp | /run)
        fail "Refusing broad project file path: $line"
        ;;
    esac
    ! paths_overlap "$normalized_path" "$CONFIG_ROOT" || \
      fail "Project file path must not overlap active configuration"
    ! paths_overlap "$normalized_path" "$STATE_ROOT" || \
      fail "Project file path must not overlap recovery state"
    ! paths_overlap "$normalized_path" "$WORK_ROOT" || \
      fail "Project file path must not overlap recovery work data"
    ! paths_overlap "$normalized_path" "$REPOSITORY_ROOT" || \
      fail "Project file path must not overlap the server-infra repository"
    [[ "$SELECTED_PROJECT_ROOT" != "$normalized_path" && \
      "$SELECTED_PROJECT_ROOT" != "$normalized_path"/* ]] || \
      fail "Project file path must not contain the Git checkout root"

    if [[ -n "$staging_dir" && \
      ("$normalized_path" == "$staging_dir" || \
      "$normalized_path" == "$staging_dir"/*) ]]; then
      continue
    fi
    [[ "$seen_paths" != *$'\n'"$normalized_path"$'\n'* ]] || \
      fail "Duplicate project file path: $normalized_path"
    seen_paths+="$normalized_path"$'\n'
    PROJECT_FILE_PATHS+=("$normalized_path")
  done < "$paths_file"
}

validate_restored_file_tree() {
  local tree_root="$1"
  local tree_label="$2"
  local unsafe_entry

  [[ (-f "$tree_root" || -d "$tree_root") && ! -L "$tree_root" ]] || \
    fail "$tree_label is missing or has an unsafe type"
  unsafe_entry="$(find "$tree_root" ! -type d ! -type f -print -quit)"
  [[ -z "$unsafe_entry" ]] || \
    fail "$tree_label contains a symlink or special file"
}

validate_installed_project_path() {
  local target_path="$1"
  local staged_path="${2:-}"

  validate_restored_file_tree "$target_path" "Installed project path"
  [[ -n "$staged_path" ]] || return 0
  if [[ -f "$staged_path" && -f "$target_path" ]]; then
    cmp -s -- "$staged_path" "$target_path" || \
      fail "Existing project file differs from the selected snapshot"
  elif [[ -d "$staged_path" && -d "$target_path" ]]; then
    diff -qr -- "$staged_path" "$target_path" >/dev/null || \
      fail "Existing project directory differs from the selected snapshot"
  else
    fail "Existing project path type differs from the selected snapshot"
  fi
}

install_project_file_path() {
  local staged_path="$1"
  local target_path="$2"
  local target_parent="${target_path%/*}"
  local target_basename="${target_path##*/}"
  local install_payload

  [[ -n "$target_parent" ]] || target_parent="/"
  validate_restored_file_tree "$staged_path" "Restored project path"
  if [[ -e "$target_path" || -L "$target_path" ]]; then
    validate_installed_project_path "$target_path" "$staged_path"
    return
  fi

  [[ -d "$target_parent" && ! -L "$target_parent" ]] || \
    fail "Project file parent directory not found: $target_parent"
  validate_no_symlink_components "$target_parent" "Project file parent"
  PROJECT_INSTALL_TEMP="$(
    mktemp -d \
      "$target_parent/.${target_basename}.files-recovery-$RECOVERY_SESSION_ID.XXXXXX"
  )"
  chmod 0700 "$PROJECT_INSTALL_TEMP"
  install_payload="$PROJECT_INSTALL_TEMP/payload"

  cp -a -- "$staged_path" "$install_payload"
  validate_installed_project_path "$install_payload" "$staged_path"

  [[ ! -e "$target_path" && ! -L "$target_path" ]] || \
    fail "Project file path appeared during restore; refusing to overwrite it"
  mv -n -- "$install_payload" "$target_path"
  [[ (-f "$target_path" || -d "$target_path") && \
    ! -e "$install_payload" ]] || \
    fail "Unable to install project path without overwriting existing data"
  rmdir "$PROJECT_INSTALL_TEMP" || \
    fail "Unable to remove empty project file staging directory"
  PROJECT_INSTALL_TEMP=""
  validate_installed_project_path "$target_path" "$staged_path"
}

run_restore_project_files() {
  local restore_args=()
  local project_path
  local restored_path
  local restic_cache

  [[ -n "$PROJECT_NAME" ]] || fail "restore-project-files requires --name"
  [[ -n "$GIT_USER" ]] || fail "restore-project-files requires --git-user"
  validate_git_user "$GIT_USER"
  load_recovery_context
  validate_projects_phase_ready
  discover_project_inventory
  select_project_record
  validate_project_checkout "$SELECTED_PROJECT_ROOT"
  load_project_file_paths
  validate_work_root
  require_command cmp
  require_command cp
  require_command diff
  require_command find
  require_command mktemp
  require_command mv
  require_command restic
  require_command rmdir

  acquire_recovery_lock
  trap cleanup EXIT
  validate_state_file
  ensure_project_state

  if [[ "$RECOVERY_PHASE_PROJECTS" == "pending" ]]; then
    RECOVERY_PHASE_PROJECTS="in-progress"
    write_state_file
  else
    [[ "$RECOVERY_PHASE_PROJECTS" == "in-progress" || \
      "$RECOVERY_PHASE_PROJECTS" == "complete" ]] || \
      fail "Project recovery phase is in an unsupported state"
  fi

  if [[ "$PROJECT_FILES_STATUS" == "complete" ]]; then
    for project_path in "${PROJECT_FILE_PATHS[@]}"; do
      validate_installed_project_path "$project_path"
    done
    refresh_projects_phase
    recovery_ok "project files are already restored: $PROJECT_NAME"
    return
  fi
  if [[ "$PROJECT_FILES_STATUS" == "pending" ]]; then
    PROJECT_FILES_STATUS="in-progress"
    write_project_state_file
  else
    [[ "$PROJECT_FILES_STATUS" == "in-progress" ]] || \
      fail "Project files restore is in an unsupported state"
  fi

  if ((${#PROJECT_FILE_PATHS[@]} == 0)); then
    PROJECT_FILES_STATUS="complete"
    write_project_state_file
    refresh_projects_phase
    recovery_ok "project has no non-database file paths to restore: $PROJECT_NAME"
    return
  fi

  ensure_work_root
  PROJECT_RESTORE_TARGET="$WORK_ROOT/project-files-$PROJECT_NAME-$RECOVERY_SESSION_ID"
  if [[ -e "$PROJECT_RESTORE_TARGET" || -L "$PROJECT_RESTORE_TARGET" ]]; then
    [[ -d "$PROJECT_RESTORE_TARGET" && \
      ! -L "$PROJECT_RESTORE_TARGET" ]] || \
      fail "Managed project restore target is not a regular directory"
    rm -rf -- "$PROJECT_RESTORE_TARGET"
  fi
  mkdir -m 0700 "$PROJECT_RESTORE_TARGET"
  restic_cache="$WORK_ROOT/restic-cache"
  mkdir -p "$restic_cache"
  chmod 0700 "$restic_cache"
  ACTIVE_RESTIC_CACHE="$restic_cache"

  restore_args=(
    restore
    "$RECOVERY_DATA_SNAPSHOT"
    --host "$RECOVERY_INSTANCE"
    --tag server-infra-data
    --target "$PROJECT_RESTORE_TARGET"
  )
  for project_path in "${PROJECT_FILE_PATHS[@]}"; do
    restore_args+=(--include "$project_path")
  done
  recovery_log \
    "Restoring declared files for $PROJECT_NAME from $RECOVERY_DATA_SNAPSHOT"
  run_break_glass_restic "${restore_args[@]}"

  for project_path in "${PROJECT_FILE_PATHS[@]}"; do
    restored_path="$PROJECT_RESTORE_TARGET$project_path"
    install_project_file_path "$restored_path" "$project_path"
  done

  PROJECT_FILES_STATUS="complete"
  write_project_state_file
  refresh_projects_phase
  recovery_ok "project files restored from pinned data snapshot: $PROJECT_NAME"
  recovery_warn "PostgreSQL and application services remain untouched"
}

run_projects_plan() {
  local sources_root
  local source_dirs=()
  local source_dir
  local checkout_state
  local files_state
  local database_state

  load_recovery_context
  validate_projects_phase_ready
  discover_project_inventory
  sources_root="$CONFIG_ROOT/backup/sources.d"
  shopt -s nullglob
  source_dirs=("$sources_root"/*)
  shopt -u nullglob

  printf 'NAME\tTYPE\tCHECKOUT\tFILES\tDATABASE\tPROJECT_ROOT\tREPOSITORY_URL\tDEPLOY_COMMIT\tDATA_SNAPSHOT\n'
  for source_dir in "${source_dirs[@]}"; do
    load_project_record "$source_dir"
    checkout_state="absent"
    files_state="not-started"
    database_state="not-started"
    if [[ "$SELECTED_PROJECT_TYPE" == "files-only" ]]; then
      database_state="not-applicable"
    fi
    if [[ -e "$SELECTED_PROJECT_ROOT" || -L "$SELECTED_PROJECT_ROOT" ]]; then
      checkout_state="present"
    fi
    PROJECT_STATE_FILE="$STATE_ROOT/projects/$SELECTED_PROJECT_NAME.env"
    if [[ -e "$PROJECT_STATE_FILE" || -L "$PROJECT_STATE_FILE" ]]; then
      validate_project_state_storage
      validate_project_state_file
      files_state="$PROJECT_FILES_STATUS"
      database_state="$PROJECT_DATABASE_STATUS"
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$SELECTED_PROJECT_NAME" \
      "$SELECTED_PROJECT_TYPE" \
      "$checkout_state" \
      "$files_state" \
      "$database_state" \
      "$SELECTED_PROJECT_ROOT" \
      "$SELECTED_PROJECT_REPOSITORY_URL" \
      "$SELECTED_PROJECT_DEPLOY_COMMIT" \
      "$RECOVERY_DATA_SNAPSHOT"
  done
}

run_clone_project() {
  local project_parent
  local project_basename
  local target_uid
  local target_gid

  [[ -n "$PROJECT_NAME" ]] || fail "clone-project requires --name"
  [[ -n "$GIT_USER" ]] || fail "clone-project requires --git-user"
  validate_git_user "$GIT_USER"
  load_recovery_context
  validate_projects_phase_ready
  discover_project_inventory
  select_project_record
  require_command git
  require_command mktemp
  require_command mv

  acquire_recovery_lock
  trap cleanup EXIT
  validate_state_file

  if [[ "$RECOVERY_PHASE_PROJECTS" == "pending" ]]; then
    RECOVERY_PHASE_PROJECTS="in-progress"
    write_state_file
  else
    [[ "$RECOVERY_PHASE_PROJECTS" == "in-progress" || \
      "$RECOVERY_PHASE_PROJECTS" == "complete" ]] || \
      fail "Project recovery phase is in an unsupported state"
  fi

  if [[ -e "$SELECTED_PROJECT_ROOT" || -L "$SELECTED_PROJECT_ROOT" ]]; then
    validate_project_checkout "$SELECTED_PROJECT_ROOT"
    recovery_ok \
      "project checkout already matches recovered inventory: $PROJECT_NAME"
    return
  fi
  [[ "$RECOVERY_PHASE_PROJECTS" != "complete" ]] || \
    fail "Completed project recovery is missing a recorded checkout"

  project_parent="${SELECTED_PROJECT_ROOT%/*}"
  project_basename="${SELECTED_PROJECT_ROOT##*/}"
  [[ -n "$project_parent" ]] || project_parent="/"
  [[ -d "$project_parent" && ! -L "$project_parent" ]] || \
    fail "Project parent directory not found: $project_parent"
  validate_no_symlink_components "$project_parent" "Project parent"

  PROJECT_CLONE_TEMP="$(
    mktemp -d \
      "$project_parent/.${project_basename}.recovery-$RECOVERY_SESSION_ID.XXXXXX"
  )"
  chmod 0700 "$PROJECT_CLONE_TEMP"
  target_uid="$(id -u "$GIT_USER")"
  target_gid="$(id -g "$GIT_USER")"
  if [[ "$(id -u)" != "$target_uid" ]]; then
    chown "$target_uid:$target_gid" "$PROJECT_CLONE_TEMP"
  fi

  recovery_log \
    "Cloning $PROJECT_NAME as $GIT_USER at $SELECTED_PROJECT_DEPLOY_COMMIT"
  run_git_as_user clone \
    --no-checkout \
    --origin origin \
    --config core.hooksPath=/dev/null \
    -- "$SELECTED_PROJECT_REPOSITORY_URL" "$PROJECT_CLONE_TEMP"
  run_git_as_user -C "$PROJECT_CLONE_TEMP" \
    fetch --no-tags origin "$SELECTED_PROJECT_DEPLOY_COMMIT"
  run_git_as_user -C "$PROJECT_CLONE_TEMP" \
    -c core.hooksPath=/dev/null \
    checkout --detach "$SELECTED_PROJECT_DEPLOY_COMMIT"
  validate_project_checkout "$PROJECT_CLONE_TEMP"

  [[ ! -e "$SELECTED_PROJECT_ROOT" && ! -L "$SELECTED_PROJECT_ROOT" ]] || \
    fail "Project root appeared during clone; refusing to overwrite it"
  mv -n -- "$PROJECT_CLONE_TEMP" "$SELECTED_PROJECT_ROOT"
  [[ -d "$SELECTED_PROJECT_ROOT" && ! -e "$PROJECT_CLONE_TEMP" ]] || \
    fail "Unable to install project checkout without overwriting existing data"
  PROJECT_CLONE_TEMP=""
  validate_project_checkout "$SELECTED_PROJECT_ROOT"

  recovery_ok \
    "project cloned at exact recovered commit: $SELECTED_PROJECT_ROOT"
  recovery_warn "Project files and database are not restored; keep the application stopped"
}

print_phase() {
  local phase_number="$1"
  local phase_state="$2"
  local phase_label="$3"

  printf '%s. [%s] %s\n' "$phase_number" "$phase_state" "$phase_label"
}

run_plan() {
  locate_state_root
  validate_state_file

  printf 'Recovery plan for %s\n\n' "$RECOVERY_INSTANCE"
  print_phase 0 "manual" "Fence the failed server and authorize temporary Git access"
  print_phase 1 "$RECOVERY_PHASE_REPOSITORY" \
    "Verify server-infra repository and exact commit"
  print_phase 2 "$RECOVERY_PHASE_CONFIG" \
    "Restore and validate /etc/server-infra from one config snapshot"
  print_phase 3 "$RECOVERY_PHASE_DATA" \
    "Select and freeze one exact data snapshot"
  print_phase 4 "$RECOVERY_PHASE_PROJECTS" \
    "Clone exact project commits and restore files and PostgreSQL"
  print_phase 5 "$RECOVERY_PHASE_FINALIZE" \
    "Validate applications, deploy Caddy, open traffic, and create a new backup"

  printf '\n'
  if [[ "$RECOVERY_PHASE_CONFIG" != "complete" ]]; then
    printf '%s\n' \
      "Next: list config-snapshots and run restore-config with one exact ID."
  elif [[ "$RECOVERY_PHASE_DATA" != "complete" ]]; then
    printf '%s\n' "Next: select and record one exact data snapshot."
  elif [[ "$RECOVERY_PHASE_PROJECTS" != "complete" ]]; then
    printf '%s\n' "Next: restore projects in dependency order."
  elif [[ "$RECOVERY_PHASE_FINALIZE" != "complete" ]]; then
    printf '%s\n' "Next: verify services before enabling public traffic."
  else
    printf '%s\n' "Next: no incomplete recovery phase was found."
  fi
}

run_status() {
  locate_state_root
  validate_state_file

  recovery_log "Session: $RECOVERY_SESSION_ID"
  recovery_log "Instance: $RECOVERY_INSTANCE"
  recovery_log "Started: $RECOVERY_STARTED_AT"
  recovery_log "Infrastructure ref: $RECOVERY_INFRA_REPOSITORY_REF"
  recovery_log "Overall: $RECOVERY_STATUS"
  recovery_log "Repository: $RECOVERY_PHASE_REPOSITORY"
  recovery_log "Configuration: $RECOVERY_PHASE_CONFIG"
  recovery_log "Configuration snapshot: ${RECOVERY_CONFIG_SNAPSHOT:-not-selected}"
  recovery_log "Data snapshot: ${RECOVERY_DATA_SNAPSHOT:-not-selected}"
  recovery_log "Projects: $RECOVERY_PHASE_PROJECTS"
  recovery_log "Finalize: $RECOVERY_PHASE_FINALIZE"
}

parse_arguments() {
  local state_root_set=0
  local break_glass_set=0
  local config_root_set=0
  local work_root_set=0
  local snapshot_set=0
  local project_name_set=0
  local git_user_set=0

  while (($# > 0)); do
    case "$1" in
      --state-root)
        (($# >= 2)) || fail "Missing value for --state-root"
        [[ "$state_root_set" == "0" ]] || \
          fail "--state-root may be specified only once"
        STATE_ROOT="$2"
        state_root_set=1
        shift 2
        ;;
      --state-root=*)
        [[ "$state_root_set" == "0" ]] || \
          fail "--state-root may be specified only once"
        STATE_ROOT="${1#*=}"
        [[ -n "$STATE_ROOT" ]] || fail "Missing value for --state-root"
        state_root_set=1
        shift
        ;;
      --break-glass)
        (($# >= 2)) || fail "Missing value for --break-glass"
        [[ "$break_glass_set" == "0" ]] || \
          fail "--break-glass may be specified only once"
        BREAK_GLASS_FILE="$2"
        break_glass_set=1
        shift 2
        ;;
      --break-glass=*)
        [[ "$break_glass_set" == "0" ]] || \
          fail "--break-glass may be specified only once"
        BREAK_GLASS_FILE="${1#*=}"
        [[ -n "$BREAK_GLASS_FILE" ]] || fail "Missing value for --break-glass"
        break_glass_set=1
        shift
        ;;
      --config-root)
        (($# >= 2)) || fail "Missing value for --config-root"
        [[ "$config_root_set" == "0" ]] || \
          fail "--config-root may be specified only once"
        CONFIG_ROOT="$2"
        config_root_set=1
        shift 2
        ;;
      --config-root=*)
        [[ "$config_root_set" == "0" ]] || \
          fail "--config-root may be specified only once"
        CONFIG_ROOT="${1#*=}"
        [[ -n "$CONFIG_ROOT" ]] || fail "Missing value for --config-root"
        config_root_set=1
        shift
        ;;
      --work-root)
        (($# >= 2)) || fail "Missing value for --work-root"
        [[ "$work_root_set" == "0" ]] || \
          fail "--work-root may be specified only once"
        WORK_ROOT="$2"
        work_root_set=1
        shift 2
        ;;
      --work-root=*)
        [[ "$work_root_set" == "0" ]] || \
          fail "--work-root may be specified only once"
        WORK_ROOT="${1#*=}"
        [[ -n "$WORK_ROOT" ]] || fail "Missing value for --work-root"
        work_root_set=1
        shift
        ;;
      --snapshot)
        (($# >= 2)) || fail "Missing value for --snapshot"
        [[ "$snapshot_set" == "0" ]] || \
          fail "--snapshot may be specified only once"
        SNAPSHOT_ID="$2"
        snapshot_set=1
        shift 2
        ;;
      --snapshot=*)
        [[ "$snapshot_set" == "0" ]] || \
          fail "--snapshot may be specified only once"
        SNAPSHOT_ID="${1#*=}"
        [[ -n "$SNAPSHOT_ID" ]] || fail "Missing value for --snapshot"
        snapshot_set=1
        shift
        ;;
      --name)
        (($# >= 2)) || fail "Missing value for --name"
        [[ "$project_name_set" == "0" ]] || \
          fail "--name may be specified only once"
        PROJECT_NAME="$2"
        project_name_set=1
        shift 2
        ;;
      --name=*)
        [[ "$project_name_set" == "0" ]] || \
          fail "--name may be specified only once"
        PROJECT_NAME="${1#*=}"
        [[ -n "$PROJECT_NAME" ]] || fail "Missing value for --name"
        project_name_set=1
        shift
        ;;
      --git-user)
        (($# >= 2)) || fail "Missing value for --git-user"
        [[ "$git_user_set" == "0" ]] || \
          fail "--git-user may be specified only once"
        GIT_USER="$2"
        git_user_set=1
        shift 2
        ;;
      --git-user=*)
        [[ "$git_user_set" == "0" ]] || \
          fail "--git-user may be specified only once"
        GIT_USER="${1#*=}"
        [[ -n "$GIT_USER" ]] || fail "Missing value for --git-user"
        git_user_set=1
        shift
        ;;
      --help | -h)
        usage
        exit 0
        ;;
      init | plan | status | config-snapshots | restore-config | \
      data-snapshots | select-data | projects-plan | clone-project | \
      restore-project-files)
        [[ -z "$OPERATION" ]] || fail "Specify exactly one operation"
        OPERATION="$1"
        shift
        ;;
      *)
        fail "Unknown argument: $1"
        ;;
    esac
  done

  [[ -n "$OPERATION" ]] || { usage; exit 1; }
  case "$OPERATION" in
    init | config-snapshots)
      [[ -z "$SNAPSHOT_ID" ]] || \
        fail "--snapshot is supported only by restore-config"
      [[ "$config_root_set" == "0" && "$work_root_set" == "0" ]] || \
        fail "--config-root and --work-root are not supported by $OPERATION"
      [[ "$project_name_set" == "0" && "$git_user_set" == "0" ]] || \
        fail "--name and --git-user are supported only by project recovery operations"
      ;;
    restore-config)
      [[ -n "$SNAPSHOT_ID" ]] || fail "restore-config requires --snapshot"
      [[ "$project_name_set" == "0" && "$git_user_set" == "0" ]] || \
        fail "--name and --git-user are supported only by project recovery operations"
      ;;
    data-snapshots)
      [[ -z "$SNAPSHOT_ID" ]] || \
        fail "--snapshot is supported only by restore-config and select-data"
      [[ "$work_root_set" == "0" ]] || \
        fail "--work-root is not supported by data-snapshots"
      [[ "$project_name_set" == "0" && "$git_user_set" == "0" ]] || \
        fail "--name and --git-user are supported only by project recovery operations"
      ;;
    select-data)
      [[ -n "$SNAPSHOT_ID" ]] || fail "select-data requires --snapshot"
      [[ "$work_root_set" == "0" ]] || \
        fail "--work-root is not supported by select-data"
      [[ "$project_name_set" == "0" && "$git_user_set" == "0" ]] || \
        fail "--name and --git-user are supported only by project recovery operations"
      ;;
    projects-plan)
      [[ -z "$SNAPSHOT_ID" ]] || \
        fail "--snapshot is not supported by projects-plan"
      [[ "$work_root_set" == "0" ]] || \
        fail "--work-root is not supported by projects-plan"
      [[ "$project_name_set" == "0" && "$git_user_set" == "0" ]] || \
        fail "--name and --git-user are supported only by project recovery operations"
      ;;
    clone-project)
      [[ -z "$SNAPSHOT_ID" ]] || \
        fail "--snapshot is not supported by clone-project"
      [[ "$work_root_set" == "0" ]] || \
        fail "--work-root is not supported by clone-project"
      [[ -n "$PROJECT_NAME" ]] || fail "clone-project requires --name"
      [[ -n "$GIT_USER" ]] || fail "clone-project requires --git-user"
      ;;
    restore-project-files)
      [[ -z "$SNAPSHOT_ID" ]] || \
        fail "--snapshot is not supported by restore-project-files"
      [[ -n "$PROJECT_NAME" ]] || \
        fail "restore-project-files requires --name"
      [[ -n "$GIT_USER" ]] || \
        fail "restore-project-files requires --git-user"
      ;;
    plan | status)
      [[ -z "$BREAK_GLASS_FILE" && -z "$SNAPSHOT_ID" ]] || \
        fail "Break-glass and snapshot options are not supported by $OPERATION"
      [[ "$config_root_set" == "0" && "$work_root_set" == "0" ]] || \
        fail "--config-root and --work-root are not supported by $OPERATION"
      [[ "$project_name_set" == "0" && "$git_user_set" == "0" ]] || \
        fail "--name and --git-user are supported only by project recovery operations"
      ;;
  esac
  if [[ "$OPERATION" != "plan" && "$OPERATION" != "status" && \
    -z "$BREAK_GLASS_FILE" ]]; then
    fail "$OPERATION requires --break-glass"
  fi
}

main() {
  parse_arguments "$@"
  validate_state_root

  case "$OPERATION" in
    init)
      run_init
      ;;
    plan)
      run_plan
      ;;
    status)
      run_status
      ;;
    config-snapshots)
      run_config_snapshots
      ;;
    restore-config)
      run_restore_config
      ;;
    data-snapshots)
      run_data_snapshots
      ;;
    select-data)
      run_select_data
      ;;
    projects-plan)
      run_projects_plan
      ;;
    clone-project)
      run_clone_project
      ;;
    restore-project-files)
      run_restore_project_files
      ;;
  esac
}

main "$@"
