#!/usr/bin/env bash

set -Eeuo pipefail

WIZARD_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RECOVERY_ROOT="$(cd "$WIZARD_BIN_DIR/.." && pwd)"
REPOSITORY_ROOT="$(cd "$RECOVERY_ROOT/.." && pwd)"
# shellcheck source=../../scripts/common.sh
source "$REPOSITORY_ROOT/scripts/common.sh"

RECOVERY_EXECUTABLE="${SERVER_INFRA_RECOVERY_EXECUTABLE:-$WIZARD_BIN_DIR/server-infra-recovery}"
DEFAULT_BREAK_GLASS_FILE="${SERVER_INFRA_BREAK_GLASS_FILE:-$REPOSITORY_ROOT/server-infra-break-glass.txt}"
STATE_ROOT="/var/lib/server-infra/recovery"
CONFIG_ROOT="/etc/server-infra"
WORK_ROOT="/var/cache/server-infra/recovery"
BREAK_GLASS_FILE=""
GIT_USER=""
RESTORE_JOBS=4
UI_MODE="${SERVER_INFRA_RECOVERY_UI:-auto}"
ACTIVE_UI=""
PROJECT_PLAN_FILE=""
SNAPSHOT_JSON_FILE=""
SNAPSHOT_LIST_FILE=""
SNAPSHOT_IDS=()
SNAPSHOT_TIMES=()
SNAPSHOT_PATHS=()
SELECTED_SNAPSHOT=""
PROJECT_NAMES=()
PROJECT_TYPES=()
PROJECT_CHECKOUT_STATES=()
PROJECT_FILE_STATES=()
PROJECT_DATABASE_STATES=()
PROJECT_DATABASE_TARGETS=()
PROJECT_ROOTS=()
PROJECT_SELECTED=()
PROJECT_SELECTABLE=()

wizard_log() {
  server_infra_emit "[server-infra][recovery-wizard]" log 1 "$*"
}

wizard_ok() {
  server_infra_emit "[server-infra][recovery-wizard]" ok 1 "$*"
}

wizard_warn() {
  server_infra_emit "[server-infra][recovery-wizard]" warn 2 "$*"
}

usage() {
  cat <<'USAGE'
Usage:
  server-infra-recovery-wizard \
    [--break-glass <absolute-path>] \
    [--git-user <ordinary-user>] \
    [--jobs <count>] \
    [--ui <auto|tui|plain>] \
    [--state-root <absolute-path>] \
    [--config-root <absolute-path>] \
    [--work-root <absolute-path>]

The wizard validates the break-glass record, lets the operator select exact
configuration and data snapshots, displays deferred infrastructure modules,
and restores selected projects.

For PostgreSQL projects it starts only the configured database Compose
service, waits for readiness, and restores into a new isolated database.
It never starts applications, changes database connection settings, deploys
the proxy, changes DNS, or enables public traffic.

Defaults:
  --break-glass <repository-root>/server-infra-break-glass.txt
  --git-user    SUDO_USER
  --jobs        4
  --ui          auto
  --state-root  /var/lib/server-infra/recovery
  --config-root /etc/server-infra
  --work-root   /var/cache/server-infra/recovery
USAGE
}

cleanup_wizard() {
  if [[ -n "$PROJECT_PLAN_FILE" && -f "$PROJECT_PLAN_FILE" ]]; then
    rm -f -- "$PROJECT_PLAN_FILE"
  fi
  PROJECT_PLAN_FILE=""
  if [[ -n "$SNAPSHOT_JSON_FILE" && -f "$SNAPSHOT_JSON_FILE" ]]; then
    rm -f -- "$SNAPSHOT_JSON_FILE"
  fi
  SNAPSHOT_JSON_FILE=""
  if [[ -n "$SNAPSHOT_LIST_FILE" && -f "$SNAPSHOT_LIST_FILE" ]]; then
    rm -f -- "$SNAPSHOT_LIST_FILE"
  fi
  SNAPSHOT_LIST_FILE=""
}

validate_wizard_path() {
  local path_value="$1"
  local path_label="$2"

  [[ "$path_value" == /* ]] || fail "$path_label must be an absolute path"
  [[ "$path_value" != *".."* && "$path_value" != *"//"* ]] || \
    fail "$path_label contains an unsafe path"
  [[ "$path_value" != *$'\n'* && "$path_value" != *$'\r'* ]] || \
    fail "$path_label contains a line break"
}

validate_no_symlink_components() {
  local path_value="$1"
  local path_label="$2"
  local current_path=""
  local component
  local components=()

  IFS='/' read -r -a components <<< "${path_value#/}"
  for component in "${components[@]}"; do
    [[ -n "$component" ]] || continue
    current_path="$current_path/$component"
    [[ ! -L "$current_path" ]] || \
      fail "$path_label contains a symlinked component: $current_path"
  done
}

validate_snapshot_id() {
  [[ "$1" =~ ^[0-9a-f]{8,64}$ ]] || \
    fail "Snapshot ID must be 8-64 lowercase hexadecimal characters"
}

validate_jobs() {
  [[ "$RESTORE_JOBS" =~ ^[1-9][0-9]*$ ]] || \
    fail "Restore jobs must be a positive integer"
  ((RESTORE_JOBS <= 32)) || fail "Restore jobs must not exceed 32"
}

resolve_ui_mode() {
  case "$UI_MODE" in
    auto)
      if [[ -t 0 && -t 1 ]] && command -v dialog >/dev/null 2>&1; then
        ACTIVE_UI="tui"
      else
        ACTIVE_UI="plain"
      fi
      ;;
    tui)
      [[ -t 0 && -t 1 ]] || \
        fail "TUI mode requires an interactive terminal"
      require_command dialog
      ACTIVE_UI="tui"
      ;;
    plain)
      ACTIVE_UI="plain"
      ;;
    *)
      fail "UI mode must be auto, tui, or plain"
      ;;
  esac
}

resolve_git_user() {
  local actual_uid

  if [[ -z "$GIT_USER" && -n "${SUDO_USER:-}" && \
    "${SUDO_USER:-}" != "root" ]]; then
    GIT_USER="$SUDO_USER"
  fi
  [[ -n "$GIT_USER" ]] || \
    fail "Specify --git-user when the wizard cannot infer SUDO_USER"
  id "$GIT_USER" >/dev/null 2>&1 || fail "Git user not found: $GIT_USER"
  actual_uid="$(id -u "$GIT_USER")"
  [[ "$actual_uid" != "0" ]] || \
    fail "Git operations require an ordinary non-root user"
}

validate_runtime() {
  validate_wizard_path "$STATE_ROOT" "State root"
  validate_wizard_path "$CONFIG_ROOT" "Configuration root"
  validate_wizard_path "$WORK_ROOT" "Work root"
  validate_wizard_path "$BREAK_GLASS_FILE" "Break-glass file"
  validate_jobs
  resolve_ui_mode
  require_command id
  require_command install
  require_command jq
  require_command mktemp
  require_command rm
  [[ -x "$RECOVERY_EXECUTABLE" && ! -L "$RECOVERY_EXECUTABLE" ]] || \
    fail "Recovery executable is not available: $RECOVERY_EXECUTABLE"

  if [[ "$STATE_ROOT" == "/var/lib/server-infra/recovery" || \
    "$CONFIG_ROOT" == "/etc/server-infra" || \
    "$WORK_ROOT" == "/var/cache/server-infra/recovery" ]]; then
    [[ "$(uname -s)" == "Linux" ]] || \
      fail "Production recovery paths require Linux"
    [[ "$EUID" == "0" ]] || \
      fail "Production recovery paths require root privileges"
  fi
}

run_recovery() {
  "$RECOVERY_EXECUTABLE" \
    --state-root "$STATE_ROOT" \
    "$@"
}

load_snapshot_inventory() {
  local snapshot_kind="$1"
  local snapshot_id
  local snapshot_time
  local snapshot_paths
  local recovery_args=()

  SNAPSHOT_IDS=()
  SNAPSHOT_TIMES=()
  SNAPSHOT_PATHS=()
  SNAPSHOT_JSON_FILE="$(
    mktemp "${TMPDIR:-/tmp}/recovery-snapshots.XXXXXX.json"
  )"
  SNAPSHOT_LIST_FILE="$(
    mktemp "${TMPDIR:-/tmp}/recovery-snapshots.XXXXXX.tsv"
  )"

  case "$snapshot_kind" in
    configuration)
      recovery_args=(
        config-snapshots
        --break-glass "$BREAK_GLASS_FILE"
        --json
      )
      ;;
    data)
      recovery_args=(
        --config-root "$CONFIG_ROOT"
        data-snapshots
        --break-glass "$BREAK_GLASS_FILE"
        --json
      )
      ;;
    *)
      fail "Unsupported snapshot inventory kind: $snapshot_kind"
      ;;
  esac

  run_recovery "${recovery_args[@]}" > "$SNAPSHOT_JSON_FILE"
  jq -e '
    type == "array" and
    all(.[];
      (.id | type == "string") and
      (.id | test("^[0-9a-f]{8,64}$")) and
      (.time | type == "string") and
      ((.paths // []) | type == "array")
    )
  ' "$SNAPSHOT_JSON_FILE" >/dev/null || \
    fail "Snapshot inventory is not valid restic JSON"
  jq -r '
    sort_by(.time)
    | reverse
    | .[]
    | [
        (.short_id // (.id[0:8])),
        (.time | sub("T"; " ") | .[0:19]),
        ((.paths // []) | join(", "))
      ]
    | @tsv
  ' "$SNAPSHOT_JSON_FILE" > "$SNAPSHOT_LIST_FILE"

  while IFS=$'\t' read -r \
    snapshot_id snapshot_time snapshot_paths; do
    [[ "$snapshot_id" =~ ^[0-9a-f]{8,64}$ ]] || \
      fail "Snapshot inventory contains an invalid ID"
    [[ -n "$snapshot_time" ]] || \
      fail "Snapshot inventory contains an empty timestamp"
    SNAPSHOT_IDS+=("$snapshot_id")
    SNAPSHOT_TIMES+=("$snapshot_time")
    SNAPSHOT_PATHS+=("${snapshot_paths:--}")
  done < "$SNAPSHOT_LIST_FILE"

  rm -f -- "$SNAPSHOT_JSON_FILE" "$SNAPSHOT_LIST_FILE"
  SNAPSHOT_JSON_FILE=""
  SNAPSHOT_LIST_FILE=""
  ((${#SNAPSHOT_IDS[@]} > 0)) || \
    fail "No $snapshot_kind snapshots were found"
}

snapshot_label() {
  local index="$1"
  local latest_label=""
  local paths="${SNAPSHOT_PATHS[$index]}"

  ((index != 0)) || latest_label=" [latest]"
  if ((${#paths} > 60)); then
    paths="${paths:0:57}..."
  fi
  printf '%s  %s%s  %s' \
    "${SNAPSHOT_TIMES[$index]}" \
    "${SNAPSHOT_IDS[$index]}" \
    "$latest_label" \
    "$paths"
}

choose_snapshot_plain() {
  local snapshot_kind="$1"
  local index
  local answer

  printf '\nAvailable %s snapshots (newest first):\n' "$snapshot_kind"
  for ((index = 0; index < ${#SNAPSHOT_IDS[@]}; index++)); do
    printf '  %d. %s\n' "$((index + 1))" "$(snapshot_label "$index")"
  done
  printf 'Select snapshot [1]: '
  IFS= read -r answer
  answer="${answer:-1}"

  if [[ "$answer" =~ ^[1-9][0-9]*$ ]]; then
    ((answer <= ${#SNAPSHOT_IDS[@]})) || \
      fail "Snapshot selection is out of range: $answer"
    SELECTED_SNAPSHOT="${SNAPSHOT_IDS[$((answer - 1))]}"
    return
  fi
  validate_snapshot_id "$answer"
  for ((index = 0; index < ${#SNAPSHOT_IDS[@]}; index++)); do
    if [[ "${SNAPSHOT_IDS[$index]}" == "$answer" ]]; then
      SELECTED_SNAPSHOT="$answer"
      return
    fi
  done
  fail "Snapshot is not present in the displayed inventory: $answer"
}

choose_snapshot_tui() {
  local snapshot_kind="$1"
  local dialog_title
  local index
  local selected
  local status
  local dialog_items=()

  case "$snapshot_kind" in
    configuration)
      dialog_title="Configuration snapshot"
      ;;
    data)
      dialog_title="Data snapshot"
      ;;
    *)
      fail "Unsupported snapshot selection kind: $snapshot_kind"
      ;;
  esac
  for ((index = 0; index < ${#SNAPSHOT_IDS[@]}; index++)); do
    status="off"
    ((index != 0)) || status="on"
    dialog_items+=(
      "${SNAPSHOT_IDS[$index]}"
      "$(snapshot_label "$index")"
      "$status"
    )
  done
  if ! selected="$(
    dialog \
      --stdout \
      --backtitle "server-infra disaster recovery" \
      --title "$dialog_title" \
      --ok-label "Select" \
      --cancel-label "Stop" \
      --radiolist \
      "Snapshots are ordered newest first. The latest is selected by default." \
      22 110 14 \
      "${dialog_items[@]}"
  )"; then
    wizard_warn "Recovery stopped during $snapshot_kind snapshot selection"
    exit 0
  fi
  validate_snapshot_id "$selected"
  SELECTED_SNAPSHOT="$selected"
}

choose_snapshot() {
  local snapshot_kind="$1"

  SELECTED_SNAPSHOT=""
  case "$ACTIVE_UI" in
    tui)
      choose_snapshot_tui "$snapshot_kind"
      ;;
    plain)
      choose_snapshot_plain "$snapshot_kind"
      ;;
  esac
  [[ -n "$SELECTED_SNAPSHOT" ]] || \
    fail "Snapshot selection returned an empty ID"
}

run_config_recovery() {
  local config_phase
  local pinned_snapshot
  local selected_snapshot

  config_phase="$(
    read_required_env_value \
      "$STATE_ROOT/session.env" \
      "RECOVERY_PHASE_CONFIG"
  )"
  pinned_snapshot="$(
    read_required_env_value \
      "$STATE_ROOT/session.env" \
      "RECOVERY_CONFIG_SNAPSHOT"
  )"

  if [[ "$config_phase" == "complete" ]]; then
    wizard_ok "Configuration is already restored from $pinned_snapshot"
    return
  fi

  if [[ "$config_phase" == "in-progress" ]]; then
    selected_snapshot="$pinned_snapshot"
    wizard_log "Resuming pinned configuration snapshot: $selected_snapshot"
  else
    load_snapshot_inventory configuration
    choose_snapshot configuration
    selected_snapshot="$SELECTED_SNAPSHOT"
  fi

  run_recovery \
    --config-root "$CONFIG_ROOT" \
    --work-root "$WORK_ROOT" \
    restore-config \
    --break-glass "$BREAK_GLASS_FILE" \
    --snapshot "$selected_snapshot"
}

run_data_selection() {
  local data_phase
  local pinned_snapshot
  local selected_snapshot

  data_phase="$(
    read_required_env_value \
      "$STATE_ROOT/session.env" \
      "RECOVERY_PHASE_DATA"
  )"
  pinned_snapshot="$(
    read_required_env_value \
      "$STATE_ROOT/session.env" \
      "RECOVERY_DATA_SNAPSHOT"
  )"

  if [[ "$data_phase" == "complete" ]]; then
    wizard_ok "Data snapshot is already pinned: $pinned_snapshot"
    return
  fi

  if [[ "$data_phase" == "in-progress" ]]; then
    selected_snapshot="$pinned_snapshot"
    wizard_log "Resuming pinned data snapshot: $selected_snapshot"
  else
    load_snapshot_inventory data
    choose_snapshot data
    selected_snapshot="$SELECTED_SNAPSHOT"
  fi

  run_recovery \
    --config-root "$CONFIG_ROOT" \
    select-data \
    --break-glass "$BREAK_GLASS_FILE" \
    --snapshot "$selected_snapshot"
}

show_infrastructure_plan() {
  local modules_file="$CONFIG_ROOT/modules.env"
  local enabled_modules
  local module_name
  local module_contract
  local module_description

  validate_env_file "$modules_file"
  enabled_modules="$(
    read_required_env_value "$modules_file" "ENABLED_MODULES"
  )"

  printf '\nInfrastructure modules (deferred):\n'
  for module_name in $enabled_modules; do
    module_contract="$REPOSITORY_ROOT/$module_name/module.env"
    if [[ -f "$module_contract" ]]; then
      module_description="$(
        read_required_env_value "$module_contract" "MODULE_DESCRIPTION"
      )"
    else
      module_description="module contract unavailable in this checkout"
    fi
    printf '  [deferred] %s — %s\n' \
      "$module_name" \
      "$module_description"
  done
  printf '%s\n' \
    "  These modules are not deployed before project validation and cutover."
  if [[ " $enabled_modules " == *" monitoring "* ]]; then
    printf '%s\n' \
      "  Monitoring named-volume state is not protected by the current backup contract."
  fi
}

load_project_plan() {
  local line_number=0
  local project_name
  local project_type
  local checkout_state
  local files_state
  local database_state
  local database_target
  local project_root
  local repository_url
  local deploy_commit
  local data_snapshot

  PROJECT_PLAN_FILE="$(mktemp "${TMPDIR:-/tmp}/recovery-projects.XXXXXX")"
  run_recovery \
    --config-root "$CONFIG_ROOT" \
    projects-plan \
    --break-glass "$BREAK_GLASS_FILE" \
    > "$PROJECT_PLAN_FILE"

  while IFS=$'\t' read -r \
    project_name \
    project_type \
    checkout_state \
    files_state \
    database_state \
    database_target \
    project_root \
    repository_url \
    deploy_commit \
    data_snapshot; do
    line_number=$((line_number + 1))
    if ((line_number == 1)); then
      [[ "$project_name" == "NAME" && "$project_type" == "TYPE" ]] || \
        fail "Unexpected projects-plan header"
      continue
    fi
    [[ -n "$project_name" && -n "$project_root" ]] || \
      fail "Invalid projects-plan row"
    PROJECT_NAMES+=("$project_name")
    PROJECT_TYPES+=("$project_type")
    PROJECT_CHECKOUT_STATES+=("$checkout_state")
    PROJECT_FILE_STATES+=("$files_state")
    PROJECT_DATABASE_STATES+=("$database_state")
    PROJECT_DATABASE_TARGETS+=("$database_target")
    PROJECT_ROOTS+=("$project_root")
    if [[ "$files_state" == "complete" && \
      ("$database_state" == "complete" || \
      "$database_state" == "not-applicable") ]]; then
      PROJECT_SELECTED+=(0)
      PROJECT_SELECTABLE+=(0)
    else
      PROJECT_SELECTED+=(1)
      PROJECT_SELECTABLE+=(1)
    fi
  done < "$PROJECT_PLAN_FILE"

  ((${#PROJECT_NAMES[@]} > 0)) || \
    fail "No recoverable projects were found in the selected snapshot"
}

render_project_selection() {
  local index
  local mark

  printf '\nProjects available for recovery:\n'
  for ((index = 0; index < ${#PROJECT_NAMES[@]}; index++)); do
    mark=" "
    [[ "${PROJECT_SELECTED[$index]}" == "0" ]] || mark="x"
    if [[ "${PROJECT_SELECTABLE[$index]}" == "0" ]]; then
      mark="done"
    fi
    printf '  [%s] %d. %s (%s; checkout=%s; files=%s; db=%s)\n' \
      "$mark" \
      "$((index + 1))" \
      "${PROJECT_NAMES[$index]}" \
      "${PROJECT_TYPES[$index]}" \
      "${PROJECT_CHECKOUT_STATES[$index]}" \
      "${PROJECT_FILE_STATES[$index]}" \
      "${PROJECT_DATABASE_STATES[$index]}"
  done
}

select_projects_plain() {
  local answer
  local token
  local selected_count
  local index

  while true; do
    render_project_selection
    printf '%s\n' \
      "Toggle project numbers separated by spaces; a=all, n=none, q=quit."
    printf 'Selection (Enter continues): '
    IFS= read -r answer
    case "$answer" in
      "")
        selected_count=0
        for token in "${PROJECT_SELECTED[@]}"; do
          [[ "$token" == "0" ]] || \
            selected_count=$((selected_count + 1))
        done
        if ((selected_count > 0)); then
          return
        fi
        wizard_warn "Select at least one project or enter q to stop"
        ;;
      a)
        for ((index = 0; index < ${#PROJECT_SELECTED[@]}; index++)); do
          if [[ "${PROJECT_SELECTABLE[$index]}" == "1" ]]; then
            PROJECT_SELECTED[$index]=1
          fi
        done
        ;;
      n)
        for ((index = 0; index < ${#PROJECT_SELECTED[@]}; index++)); do
          PROJECT_SELECTED[$index]=0
        done
        ;;
      q)
        wizard_warn "Recovery stopped before project changes"
        exit 0
        ;;
      *)
        for token in $answer; do
          [[ "$token" =~ ^[1-9][0-9]*$ ]] || \
            fail "Invalid project selection: $token"
          ((token <= ${#PROJECT_NAMES[@]})) || \
            fail "Project selection is out of range: $token"
          index=$((token - 1))
          if [[ "${PROJECT_SELECTABLE[$index]}" == "0" ]]; then
            wizard_warn \
              "Project is already complete and cannot be selected again: ${PROJECT_NAMES[$index]}"
            continue
          fi
          if [[ "${PROJECT_SELECTED[$index]}" == "0" ]]; then
            PROJECT_SELECTED[$index]=1
          else
            PROJECT_SELECTED[$index]=0
          fi
        done
        ;;
    esac
  done
}

select_projects_tui() {
  local index
  local selected_projects
  local selected_name
  local completed_summary=""
  local status
  local dialog_items=()

  for ((index = 0; index < ${#PROJECT_NAMES[@]}; index++)); do
    if [[ "${PROJECT_SELECTABLE[$index]}" == "0" ]]; then
      completed_summary+="\n  [done] ${PROJECT_NAMES[$index]}"
      continue
    fi
    status="off"
    [[ "${PROJECT_SELECTED[$index]}" == "0" ]] || status="on"
    dialog_items+=(
      "${PROJECT_NAMES[$index]}"
      "${PROJECT_TYPES[$index]}; files=${PROJECT_FILE_STATES[$index]}; db=${PROJECT_DATABASE_STATES[$index]}"
      "$status"
    )
  done

  if ((${#dialog_items[@]} == 0)); then
    return
  fi
  if ! selected_projects="$(
    dialog \
      --stdout \
      --separate-output \
      --backtitle "server-infra disaster recovery" \
      --title "Projects to recover" \
      --ok-label "Continue" \
      --cancel-label "Stop" \
      --checklist \
      "Space toggles projects. Completed projects are not offered again.${completed_summary}" \
      24 110 15 \
      "${dialog_items[@]}"
  )"; then
    wizard_warn "Recovery stopped before project changes"
    exit 0
  fi

  for ((index = 0; index < ${#PROJECT_SELECTED[@]}; index++)); do
    PROJECT_SELECTED[$index]=0
  done
  while IFS= read -r selected_name || [[ -n "$selected_name" ]]; do
    [[ -n "$selected_name" ]] || continue
    for ((index = 0; index < ${#PROJECT_NAMES[@]}; index++)); do
      if [[ "${PROJECT_NAMES[$index]}" == "$selected_name" && \
        "${PROJECT_SELECTABLE[$index]}" == "1" ]]; then
        PROJECT_SELECTED[$index]=1
        break
      fi
    done
  done <<< "$selected_projects"
}

selected_project_count() {
  local index
  local selected_count=0

  for ((index = 0; index < ${#PROJECT_SELECTED[@]}; index++)); do
    if [[ "${PROJECT_SELECTED[$index]}" == "1" ]]; then
      selected_count=$((selected_count + 1))
    fi
  done
  printf '%s' "$selected_count"
}

select_projects() {
  local selectable_count=0
  local index

  for ((index = 0; index < ${#PROJECT_SELECTABLE[@]}; index++)); do
    if [[ "${PROJECT_SELECTABLE[$index]}" == "1" ]]; then
      selectable_count=$((selectable_count + 1))
    fi
  done
  if ((selectable_count == 0)); then
    render_project_selection
    wizard_ok "All recoverable projects are already complete"
    return
  fi

  case "$ACTIVE_UI" in
    tui)
      select_projects_tui
      ;;
    plain)
      select_projects_plain
      ;;
  esac
}

confirm_project_recovery_plain() {
  local config_snapshot
  local data_snapshot
  local index
  local answer

  config_snapshot="$(
    read_required_env_value "$STATE_ROOT/session.env" "RECOVERY_CONFIG_SNAPSHOT"
  )"
  data_snapshot="$(
    read_required_env_value "$STATE_ROOT/session.env" "RECOVERY_DATA_SNAPSHOT"
  )"
  printf '\nRecovery confirmation:\n'
  printf '  Configuration snapshot: %s\n' "$config_snapshot"
  printf '  Data snapshot:          %s\n' "$data_snapshot"
  printf '  Projects:\n'
  for ((index = 0; index < ${#PROJECT_NAMES[@]}; index++)); do
    [[ "${PROJECT_SELECTED[$index]}" == "1" ]] || continue
    printf '    - %s (%s)\n' \
      "${PROJECT_NAMES[$index]}" \
      "${PROJECT_TYPES[$index]}"
  done
  printf 'Continue with project recovery? [y/N] '
  IFS= read -r answer
  case "$answer" in
    y | Y | yes | YES)
      return
      ;;
    *)
      return 1
      ;;
  esac
}

confirm_project_recovery_tui() {
  local config_snapshot
  local data_snapshot
  local index
  local confirmation_text

  config_snapshot="$(
    read_required_env_value "$STATE_ROOT/session.env" "RECOVERY_CONFIG_SNAPSHOT"
  )"
  data_snapshot="$(
    read_required_env_value "$STATE_ROOT/session.env" "RECOVERY_DATA_SNAPSHOT"
  )"
  confirmation_text="Configuration: $config_snapshot\nData: $data_snapshot\n\nProjects:"
  for ((index = 0; index < ${#PROJECT_NAMES[@]}; index++)); do
    [[ "${PROJECT_SELECTED[$index]}" == "1" ]] || continue
    confirmation_text+="\n  - ${PROJECT_NAMES[$index]} (${PROJECT_TYPES[$index]})"
  done
  dialog \
    --stdout \
    --backtitle "server-infra disaster recovery" \
    --title "Confirm project recovery" \
    --yes-label "Recover" \
    --no-label "Back" \
    --defaultno \
    --yesno "$confirmation_text" \
    18 90
}

confirm_project_recovery() {
  case "$ACTIVE_UI" in
    tui)
      confirm_project_recovery_tui
      ;;
    plain)
      confirm_project_recovery_plain
      ;;
  esac
}

ensure_project_parent() {
  local project_root="$1"
  local project_parent
  local answer
  local target_gid

  project_parent="${project_root%/*}"
  [[ -n "$project_parent" ]] || project_parent="/"
  validate_wizard_path "$project_parent" "Project parent"
  validate_no_symlink_components "$project_parent" "Project parent"
  if [[ -d "$project_parent" && ! -L "$project_parent" ]]; then
    return
  fi
  [[ ! -e "$project_parent" && ! -L "$project_parent" ]] || \
    fail "Project parent is not a safe directory: $project_parent"

  printf 'Create project parent %s for %s? [Y/n] ' \
    "$project_parent" \
    "$GIT_USER"
  IFS= read -r answer
  case "$answer" in
    "" | y | Y | yes | YES)
      target_gid="$(id -g "$GIT_USER")"
      install -d \
        -o "$GIT_USER" \
        -g "$target_gid" \
        -m 0750 \
        "$project_parent"
      ;;
    *)
      fail "Project parent is required: $project_parent"
      ;;
  esac
}

default_database_target() {
  local project_name="$1"
  local database_name="${project_name//-/_}"

  database_name="${database_name:0:53}_recovered"
  printf '%s' "$database_name"
}

restore_selected_project() {
  local index="$1"
  local project_name="${PROJECT_NAMES[$index]}"
  local project_type="${PROJECT_TYPES[$index]}"
  local database_target="${PROJECT_DATABASE_TARGETS[$index]}"
  local default_target
  local answer

  wizard_log "Recovering project: $project_name"
  ensure_project_parent "${PROJECT_ROOTS[$index]}"
  run_recovery \
    --config-root "$CONFIG_ROOT" \
    clone-project \
    --break-glass "$BREAK_GLASS_FILE" \
    --name "$project_name" \
    --git-user "$GIT_USER"
  run_recovery \
    --config-root "$CONFIG_ROOT" \
    --work-root "$WORK_ROOT" \
    restore-project-files \
    --break-glass "$BREAK_GLASS_FILE" \
    --name "$project_name" \
    --git-user "$GIT_USER"

  if [[ "$project_type" == "files-only" ]]; then
    wizard_ok "Files-only project recovered: $project_name"
    return
  fi
  [[ "$project_type" == "postgres-compose" ]] || \
    fail "Unsupported project type in recovery plan: $project_type"

  if [[ "$database_target" != "-" ]]; then
    default_target="$database_target"
  else
    default_target="$(default_database_target "$project_name")"
  fi
  if [[ "$ACTIVE_UI" == "tui" ]]; then
    if ! answer="$(
      dialog \
        --stdout \
        --backtitle "server-infra disaster recovery" \
        --title "PostgreSQL restore target" \
        --ok-label "Restore" \
        --cancel-label "Stop" \
        --inputbox \
        "Target database for $project_name. The configured source database is never overwritten." \
        12 90 \
        "$default_target"
    )"; then
      wizard_warn "Recovery stopped before restoring $project_name database"
      exit 0
    fi
  else
    printf 'Target database for %s [%s]: ' "$project_name" "$default_target"
    IFS= read -r answer
  fi
  database_target="${answer:-$default_target}"

  run_recovery \
    --config-root "$CONFIG_ROOT" \
    restore-project-db \
    --break-glass "$BREAK_GLASS_FILE" \
    --name "$project_name" \
    --git-user "$GIT_USER" \
    --target-db "$database_target" \
    --jobs "$RESTORE_JOBS" \
    --start-service
  wizard_ok "Project restored into isolated database: $project_name"
}

run_project_recovery() {
  local index

  load_project_plan
  select_projects
  if [[ "$(selected_project_count)" == "0" ]]; then
    wizard_ok "No incomplete projects were selected"
    return 1
  fi
  if ! confirm_project_recovery; then
    wizard_warn "Recovery stopped before project changes"
    return 1
  fi
  for ((index = 0; index < ${#PROJECT_NAMES[@]}; index++)); do
    [[ "${PROJECT_SELECTED[$index]}" == "1" ]] || continue
    restore_selected_project "$index"
  done
}

parse_arguments() {
  local ui_mode_set=0

  while (($# > 0)); do
    case "$1" in
      --break-glass)
        (($# >= 2)) || fail "Missing value for --break-glass"
        [[ -z "$BREAK_GLASS_FILE" ]] || \
          fail "--break-glass may be specified only once"
        BREAK_GLASS_FILE="$2"
        shift 2
        ;;
      --git-user)
        (($# >= 2)) || fail "Missing value for --git-user"
        [[ -z "$GIT_USER" ]] || \
          fail "--git-user may be specified only once"
        GIT_USER="$2"
        shift 2
        ;;
      --jobs)
        (($# >= 2)) || fail "Missing value for --jobs"
        RESTORE_JOBS="$2"
        shift 2
        ;;
      --ui)
        (($# >= 2)) || fail "Missing value for --ui"
        [[ "$ui_mode_set" == "0" ]] || \
          fail "--ui may be specified only once"
        UI_MODE="$2"
        ui_mode_set=1
        shift 2
        ;;
      --ui=*)
        [[ "$ui_mode_set" == "0" ]] || \
          fail "--ui may be specified only once"
        UI_MODE="${1#*=}"
        [[ -n "$UI_MODE" ]] || fail "Missing value for --ui"
        ui_mode_set=1
        shift
        ;;
      --state-root)
        (($# >= 2)) || fail "Missing value for --state-root"
        STATE_ROOT="$2"
        shift 2
        ;;
      --config-root)
        (($# >= 2)) || fail "Missing value for --config-root"
        CONFIG_ROOT="$2"
        shift 2
        ;;
      --work-root)
        (($# >= 2)) || fail "Missing value for --work-root"
        WORK_ROOT="$2"
        shift 2
        ;;
      --help | -h)
        usage
        exit 0
        ;;
      *)
        fail "Unknown argument: $1"
        ;;
    esac
  done
  if [[ -z "$BREAK_GLASS_FILE" ]]; then
    BREAK_GLASS_FILE="$DEFAULT_BREAK_GLASS_FILE"
  fi
}

main() {
  parse_arguments "$@"
  validate_runtime
  trap cleanup_wizard EXIT

  wizard_log "Validating break-glass record and recovery session"
  run_recovery \
    init \
    --break-glass "$BREAK_GLASS_FILE"
  run_config_recovery
  run_data_selection
  show_infrastructure_plan
  resolve_git_user
  if ! run_project_recovery; then
    printf '\n'
    run_recovery status
    exit 0
  fi

  printf '\n'
  run_recovery status
  printf '\n'
  wizard_ok "Selected projects reached the isolated restore stage"
  wizard_warn \
    "Application validation, database cutover, infrastructure deployment, DNS, and traffic remain manual"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
