#!/usr/bin/env bash

set -Eeuo pipefail

[[ -n "${FAKE_RECOVERY_LOG:-}" ]]
[[ -n "${FAKE_RECOVERY_PROJECT_ROOT:-}" ]]

printf '%s ' "$@" >> "$FAKE_RECOVERY_LOG"
printf '\n' >> "$FAKE_RECOVERY_LOG"

state_root=""
config_root=""
snapshot_id=""
target_database=""
operation=""
start_service=0

while (($# > 0)); do
  case "$1" in
    --state-root)
      state_root="$2"
      shift 2
      ;;
    --config-root)
      config_root="$2"
      shift 2
      ;;
    --work-root | --break-glass | --name | --git-user | --jobs)
      shift 2
      ;;
    --snapshot)
      snapshot_id="$2"
      shift 2
      ;;
    --target-db)
      target_database="$2"
      shift 2
      ;;
    --start-service)
      start_service=1
      shift
      ;;
    init | config-snapshots | restore-config | data-snapshots | \
    select-data | projects-plan | clone-project | \
    restore-project-files | restore-project-db | status)
      operation="$1"
      shift
      ;;
    *)
      exit 1
      ;;
  esac
done

[[ -n "$state_root" ]]
state_file="$state_root/session.env"

write_state() {
  umask 077
  mkdir -p "$state_root"
  chmod 0700 "$state_root"
  printf '%s\n' \
    "RECOVERY_PHASE_CONFIG=$recovery_phase_config" \
    "RECOVERY_CONFIG_SNAPSHOT=$recovery_config_snapshot" \
    "RECOVERY_PHASE_DATA=$recovery_phase_data" \
    "RECOVERY_DATA_SNAPSHOT=$recovery_data_snapshot" \
    > "$state_file"
  chmod 0600 "$state_file"
}

load_state() {
  # Test-only state is generated by this fake executable.
  # shellcheck disable=SC1090
  source "$state_file"
  recovery_phase_config="$RECOVERY_PHASE_CONFIG"
  recovery_config_snapshot="$RECOVERY_CONFIG_SNAPSHOT"
  recovery_phase_data="$RECOVERY_PHASE_DATA"
  recovery_data_snapshot="$RECOVERY_DATA_SNAPSHOT"
}

case "$operation" in
  init)
    if [[ ! -f "$state_file" ]]; then
      recovery_phase_config="pending"
      recovery_config_snapshot=""
      recovery_phase_data="pending"
      recovery_data_snapshot=""
      write_state
    fi
    printf '[fake-recovery][ok] session initialized\n'
    ;;
  config-snapshots)
    printf 'abcdef12\t2026-07-24T01:00:00Z\tconfig\n'
    ;;
  restore-config)
    [[ "$snapshot_id" == "abcdef12" ]]
    [[ -n "$config_root" ]]
    load_state
    recovery_phase_config="complete"
    recovery_config_snapshot="$snapshot_id"
    write_state
    mkdir -p "$config_root"
    printf '%s\n' \
      'ENABLED_MODULES="backup proxy monitoring"' \
      > "$config_root/modules.env"
    printf '[fake-recovery][ok] configuration restored\n'
    ;;
  data-snapshots)
    printf 'deadbeef\t2026-07-24T02:00:00Z\tdata\n'
    ;;
  select-data)
    [[ "$snapshot_id" == "deadbeef" ]]
    load_state
    recovery_phase_data="complete"
    recovery_data_snapshot="$snapshot_id"
    write_state
    printf '[fake-recovery][ok] data snapshot selected\n'
    ;;
  projects-plan)
    printf '%s\n' \
      $'NAME\tTYPE\tCHECKOUT\tFILES\tDATABASE\tDATABASE_TARGET\tPROJECT_ROOT\tREPOSITORY_URL\tDEPLOY_COMMIT\tDATA_SNAPSHOT'
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "acceptance-app" \
      "postgres-compose" \
      "absent" \
      "not-started" \
      "not-started" \
      "-" \
      "$FAKE_RECOVERY_PROJECT_ROOT" \
      "git@github.com:example/acceptance-app.git" \
      "0123456789abcdef0123456789abcdef01234567" \
      "deadbeef"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "static-site" \
      "files-only" \
      "absent" \
      "not-started" \
      "not-applicable" \
      "-" \
      "${FAKE_RECOVERY_PROJECT_ROOT%/*}/static-site" \
      "git@github.com:example/static-site.git" \
      "abcdef0123456789abcdef0123456789abcdef01" \
      "deadbeef"
    ;;
  clone-project)
    mkdir -p "$FAKE_RECOVERY_PROJECT_ROOT"
    printf '[fake-recovery][ok] project cloned\n'
    ;;
  restore-project-files)
    printf '[fake-recovery][ok] project files restored\n'
    ;;
  restore-project-db)
    [[ "$target_database" == "acceptance_app_recovered" ]]
    [[ "$start_service" == "1" ]]
    printf '[fake-recovery][ok] project database restored\n'
    ;;
  status)
    printf '[fake-recovery] Overall: in-progress\n'
    ;;
  *)
    exit 1
    ;;
esac
